
/* ======================================================================
   MO2 Fluent v4: Windows 11 style layer.
   Generated by Build-FluentTheme.ps1 from this template; @name@ tokens are
   replaced per theme. Rules repeat the selectors of the base theme so they
   win by order without raising specificity.
   ====================================================================== */

QWidget {
    font-family: "Segoe UI Variable Text", "Segoe UI";
    selection-background-color: @sel@;
    selection-color: @text@;
}

QMainWindow, QDialog, QMessageBox,
QMainWindow#MainWindow QWidget#centralWidget {
    background-color: @bg@;
}

QWidget:disabled {
    color: @faint@;
}

/* Command bar: flat buttons on the window surface, a hairline below. */
QMenuBar {
    color: @text@;
    background-color: @bg@;
    border: none;
    padding: 2px 4px;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background-color: transparent;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: @hover@;
}

QToolBar, QMainWindow#MainWindow QToolBar#toolBar {
    background-color: @bg@;
    border: none;
    border-bottom: 1px solid @line@;
    padding: 4px 8px 4px 8px;
    spacing: 4px;
}
QToolBar > QWidget,
QMainWindow#MainWindow QToolBar#toolBar > QWidget {
    background-color: transparent;
}
QToolButton {
    color: @text@;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: @hover@;
    border-color: transparent;
}
QToolButton:pressed, QToolButton:checked {
    color: @muted@;
    background-color: @pressed@;
    border-color: transparent;
}
/* Command bar: 16px glyphs, compact 32px buttons like File Explorer's. */
QMainWindow#MainWindow QToolBar#toolBar QToolButton {
    margin: 0px 1px;
    padding: 6px 8px;
}
QToolButton::menu-indicator {
    image: url(./@assets@/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
    right: 3px;
    bottom: 3px;
}
/* buttons with the turning chevron (FluentMotion::animateMenuChevron) draw
   their own */
QToolButton[fluentChevron="true"]::menu-indicator {
    image: none;
    width: 0px;
}

/* Menus: one rounded flyout, compact rows, no descriptions. */
QMenu,
QMenu#modListOptionsMenu,
QMenu#openFolderMenuPopup {
    color: @text@;
    background-color: @menu@;
    border: 1px solid @menuLine@;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item,
QMenu#modListOptionsMenu::item,
QMenu#openFolderMenuPopup::item {
    min-height: 22px;
    padding: 5px 28px 5px 10px;
    margin: 1px 0px;
    border-radius: 4px;
    background-color: transparent;
}
QMenu::item:selected,
QMenu#modListOptionsMenu::item:selected,
QMenu#openFolderMenuPopup::item:selected {
    color: @text@;
    background-color: @hover@;
}
QMenu::item:disabled,
QMenu#modListOptionsMenu::item:disabled,
QMenu#openFolderMenuPopup::item:disabled {
    color: @faint@;
}
QMenu::separator,
QMenu#modListOptionsMenu::separator,
QMenu#openFolderMenuPopup::separator {
    height: 1px;
    margin: 4px 0px;
    background-color: @line@;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::right-arrow {
    image: url(./@assets@/chevron-right.svg);
    width: 10px;
    height: 10px;
}
/* check boxes and radio buttons inside menus (categories) get the height,
   padding and hover of a menu row */
QMenu QCheckBox,
QMenu QRadioButton {
    min-height: 22px;
    padding: 5px 28px 5px 10px;
    margin: 1px 0px;
    border-radius: 4px;
    spacing: 10px;
    background-color: transparent;
}
QMenu QCheckBox:hover,
QMenu QRadioButton:hover {
    background-color: @hover@;
}

QToolTip {
    color: @text@;
    background-color: @menu@;
    border: 1px solid @menuLine@;
    border-radius: 4px;
    padding: 5px 8px;
}

/* Buttons: standard Fluent button with a slightly darker lower edge. */
QPushButton {
    color: @text@;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background-color: @btnHover@;
}
QPushButton:pressed {
    color: @muted@;
    background-color: @btnPressed@;
    border-bottom-color: @btnLine@;
}
QPushButton:disabled {
    color: @faint@;
    background-color: @disabledBg@;
    border-color: @line@;
}
QPushButton:default {
    color: @accentFg@;
    background-color: @accent@;
    border: 1px solid @accent@;
}
QPushButton:default:hover {
    background-color: @accentHover@;
    border-color: @accentHover@;
}
QPushButton:default:pressed {
    background-color: @accentPressed@;
    border-color: @accentPressed@;
}

/* Text fields: flat field, accent bottom edge when focused. */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QDateEdit, QTimeEdit, QDateTimeEdit, QPlainTextEdit,
QTextEdit, QAbstractSpinBox {
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
    border-radius: 4px;
    padding: 4px 8px;
}
QComboBox, QComboBox:hover, QComboBox:on {
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover {
    background-color: @fieldHover@;
}
QPushButton:focus {
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
}
QComboBox:focus, QLineEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QAbstractSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 2px solid @accent@;
    padding-bottom: 3px;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
    background-color: transparent;
}
QComboBox::down-arrow {
    image: url(./@assets@/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QComboBox QFrame {
    color: @text@;
    background-color: @menu@;
    border: 1px solid @menuLine@;
    border-radius: 8px;
}
QComboBox QAbstractItemView {
    color: @text@;
    background-color: transparent;
    border: none;
    padding: 4px;
    selection-background-color: @hover@;
    selection-color: @text@;
}
QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 3px 10px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover,
QComboBox#profileBox QAbstractItemView::item:hover {
    color: @text@;
    background-color: @hover@;
}
QComboBox QAbstractItemView::item:selected {
    color: @text@;
    background-color: @sel@;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @hover@;
}

/* Check boxes, radio buttons, and switches. */
/* Every state repeats border and fill: the dark bases give the indicator
   states their own border and fill, which outrank the plain ::indicator rule
   and showed as a ring behind the drawn radio and box. */
QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator, QTableView::indicator, QListView::indicator {
    width: 18px;
    height: 18px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
}
QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked,
QTreeView::indicator:unchecked, QTableView::indicator:unchecked, QListView::indicator:unchecked {
    image: url(./@assets@/checkbox-unchecked.svg);
    border: none;
    background-color: transparent;
}
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover,
QTreeView::indicator:unchecked:hover, QTableView::indicator:unchecked:hover, QListView::indicator:unchecked:hover {
    image: url(./@assets@/checkbox-unchecked-hover.svg);
    border: none;
    background-color: transparent;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked, QTableView::indicator:checked, QListView::indicator:checked {
    image: url(./@assets@/checkbox-checked.svg);
    border: none;
    background-color: transparent;
}
QCheckBox::indicator:indeterminate, QGroupBox::indicator:indeterminate,
QTreeView::indicator:indeterminate, QTableView::indicator:indeterminate, QListView::indicator:indeterminate {
    image: url(./@assets@/checkbox-indeterminate.svg);
    border: none;
    background-color: transparent;
}
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled,
QTreeView::indicator:unchecked:disabled, QTableView::indicator:unchecked:disabled, QListView::indicator:unchecked:disabled {
    image: url(./@assets@/checkbox-disabled.svg);
    border: none;
    background-color: transparent;
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled, QTableView::indicator:checked:disabled, QListView::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled, QGroupBox::indicator:indeterminate:disabled,
QTreeView::indicator:indeterminate:disabled, QTableView::indicator:indeterminate:disabled, QListView::indicator:indeterminate:disabled {
    image: url(./@assets@/checkbox-checked-disabled.svg);
    border: none;
    background-color: transparent;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: none;
    background-color: transparent;
}
QRadioButton::indicator:unchecked {
    image: url(./@assets@/radio-unchecked.svg);
    border: none;
    background-color: transparent;
}
QRadioButton::indicator:unchecked:hover {
    image: url(./@assets@/radio-unchecked-hover.svg);
    border: none;
    background-color: transparent;
}
QRadioButton::indicator:checked {
    image: url(./@assets@/radio-checked.svg);
    border: none;
    background-color: transparent;
}
QRadioButton::indicator:unchecked:disabled {
    image: url(./@assets@/radio-disabled.svg);
    border: none;
    background-color: transparent;
}
QRadioButton::indicator:checked:disabled {
    image: url(./@assets@/radio-checked-disabled.svg);
    border: none;
    background-color: transparent;
}

/* Lists, trees, and headers. */
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    color: @text@;
    background-color: @card@;
    alternate-background-color: @rowAlt@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
    gridline-color: @line@;
    selection-background-color: @sel@;
    selection-color: @text@;
}
QTreeView::item:hover:!selected, QTreeWidget::item:hover:!selected,
QListView::item:hover:!selected, QListWidget::item:hover:!selected,
QTableView::item:hover:!selected, QTableWidget::item:hover:!selected {
    color: @text@;
    background-color: @rowHover@;
}
QHeaderView::section {
    color: @muted@;
    background-color: @card@;
    border: none;
    border-right: 1px solid @line@;
    border-bottom: 1px solid @line@;
    padding: 6px 9px;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: @rowHover@;
}

QScrollBar:vertical {
    width: 10px;
    background-color: transparent;
    margin: 2px;
}
QScrollBar:horizontal {
    height: 10px;
    background-color: transparent;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: @scroll@;
    border: none;
    border-radius: 3px;
    min-height: 28px;
    min-width: 28px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: @scrollHover@;
}

QSplitter::handle,
QWidget#centralWidget QSplitter#splitter::handle,
QSplitter#categoriesSplitter::handle,
QSplitter::handle:hover, QSplitter::handle:pressed,
QWidget#centralWidget QSplitter#splitter::handle:hover,
QWidget#centralWidget QSplitter#splitter::handle:pressed,
QSplitter#categoriesSplitter::handle:hover,
QSplitter#categoriesSplitter::handle:pressed {
    background-color: @bg@;
    border: none;
    image: none;
}
QWidget#centralWidget QSplitter#splitter::handle:horizontal {
    width: 10px;
}

QProgressBar {
    color: @text@;
    background-color: @line@;
    border: none;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 4px;
}

QGroupBox::title {
    color: @muted@;
    background-color: transparent;
}

/* Main window: profile row. */
QMainWindow#MainWindow QWidget#centralWidget QLabel#label_3 {
    min-height: 32px;
    max-height: 32px;
    color: @muted@;
    background-color: transparent;
    border: none;
    font-weight: 600;
    padding: 0px 2px 0px 4px;
}
QMainWindow#MainWindow QComboBox#profileBox,
QMainWindow#MainWindow QComboBox#profileBox:hover,
QMainWindow#MainWindow QComboBox#profileBox:on {
    min-height: 30px;
    max-height: 30px;
    padding: 0px 30px 0px 10px;
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
    border-radius: 4px;
}
QMainWindow#MainWindow QComboBox#profileBox:hover {
    background-color: @fieldHover@;
    border-color: @fieldLine@;
    border-bottom-color: @fieldBottom@;
}
QMainWindow#MainWindow QComboBox#profileBox:focus {
    background-color: @field@;
    border-color: @fieldLine@;
    border-bottom: 2px solid @accent@;
}
QMainWindow#MainWindow QComboBox#profileBox::drop-down,
QMainWindow#MainWindow QComboBox#profileBox::drop-down:hover {
    width: 28px;
    border: none;
    background-color: transparent;
}
QMainWindow#MainWindow QComboBox#profileBox::down-arrow {
    image: url(./@assets@/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn,
QMainWindow#MainWindow QPushButton#openFolderMenu {
    min-width: 34px;
    max-width: 34px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px;
    color: @text@;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:hover,
QMainWindow#MainWindow QPushButton#openFolderMenu:hover {
    background-color: @hover@;
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:pressed,
QMainWindow#MainWindow QPushButton#openFolderMenu:pressed {
    background-color: @pressed@;
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:focus,
QMainWindow#MainWindow QPushButton#openFolderMenu:focus {
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn::menu-indicator,
QMainWindow#MainWindow QPushButton#openFolderMenu::menu-indicator {
    image: none;
    width: 0px;
}

QLCDNumber#activeModsCounter {
    color: @accentText@;
}
QFrame[lcdFrame="true"] {
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-radius: 4px;
}
QFrame#activeModsCounterFrame {
    min-height: 30px;
    max-height: 30px;
    background-color: @accentSubtle@;
    border: 1px solid @accentSubtle@;
    border-radius: 4px;
}

/* Main window: mod list card. Enabled state uses Fluent switches. */
QMainWindow#MainWindow QTreeView#modList {
    color: @text@;
    background-color: @card@;
    alternate-background-color: @rowAlt@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
    gridline-color: @line@;
    selection-background-color: @sel@;
    selection-color: @text@;
}
QMainWindow#MainWindow QTreeView#modList:focus {
    border-color: @cardLine@;
}
QMainWindow#MainWindow QTreeView#modList::item:hover:!selected {
    background-color: @rowHover@;
}
QMainWindow#MainWindow QTreeView#modList::item:selected,
QMainWindow#MainWindow QTreeView#modList::item:selected:focus,
QMainWindow#MainWindow QTreeView#modList::item:hover:selected {
    color: @text@;
    background-color: @sel@;
}
QMainWindow#MainWindow QTreeView#modList::item:selected:first,
QMainWindow#MainWindow QTreeView#modList::item:selected:focus:first,
QMainWindow#MainWindow QTreeView#modList::item:hover:selected:first {
    border-left: 3px solid @accent@;
    padding-left: 7px;
}
QMainWindow#MainWindow QTreeView#modList QHeaderView::section {
    min-height: 28px;
    padding: 6px 9px;
    color: @muted@;
    background-color: @card@;
    border: none;
    border-bottom: 1px solid @line@;
    font-weight: 600;
}
QMainWindow#MainWindow QTreeView#modList QHeaderView::section:hover {
    background-color: @rowHover@;
}
QTreeView#modList QHeaderView::up-arrow {
    image: url(./@assets@/sort-up.svg);
}
QTreeView#modList QHeaderView::down-arrow {
    image: url(./@assets@/sort-down.svg);
}
QTreeView#modList::indicator {
    width: 36px;
    height: 18px;
}
QTreeView#modList::indicator:unchecked {
    image: url(./@assets@/switch-off.svg);
}
QTreeView#modList::indicator:unchecked:hover {
    image: url(./@assets@/switch-off-hover.svg);
}
QTreeView#modList::indicator:checked,
QTreeView#modList::indicator:indeterminate {
    image: url(./@assets@/switch-on.svg);
}
QTreeView#modList::indicator:checked:hover {
    image: url(./@assets@/switch-on-hover.svg);
}
QTreeView#modList::indicator:unchecked:disabled {
    image: url(./@assets@/switch-off-disabled.svg);
}
QTreeView#modList::indicator:checked:disabled,
QTreeView#modList::indicator:indeterminate:disabled {
    image: url(./@assets@/switch-on-disabled.svg);
}

/* Main window: mod list footer. */
QMainWindow#MainWindow QPushButton#displayCategoriesBtn,
QMainWindow#MainWindow QPushButton#clearFiltersButton {
    min-height: 30px;
    color: @text@;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
    border-radius: 4px;
}
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:hover,
QMainWindow#MainWindow QPushButton#clearFiltersButton:hover {
    background-color: @btnHover@;
    border-color: @btnLine@;
    border-bottom-color: @btnBottom@;
}
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:checked,
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:pressed {
    color: @accentFg@;
    background-color: @accent@;
    border-color: @accent@;
}
QMainWindow#MainWindow QWidget#centralWidget QLabel#label_2,
QMainWindow#MainWindow QLabel#currentCategoryLabel {
    color: @muted@;
}
QMainWindow#MainWindow QComboBox#groupCombo,
QMainWindow#MainWindow QLineEdit#modFilterEdit {
    min-height: 30px;
    max-height: 32px;
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
    border-radius: 4px;
}
QMainWindow#MainWindow QComboBox#groupCombo:hover {
    background-color: @fieldHover@;
    border-color: @fieldLine@;
    border-bottom-color: @fieldBottom@;
}
QMainWindow#MainWindow QComboBox#groupCombo:focus,
QMainWindow#MainWindow QLineEdit#modFilterEdit:focus {
    border-color: @fieldLine@;
    border-bottom: 2px solid @accent@;
}
QMainWindow#MainWindow QComboBox#groupCombo::drop-down,
QMainWindow#MainWindow QComboBox#groupCombo::drop-down:hover {
    width: 28px;
    border: none;
    background-color: transparent;
}
QMainWindow#MainWindow QComboBox#groupCombo::down-arrow {
    image: url(./@assets@/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* Main window: executable picker and the accent Run button. */
QFrame#startGroup {
    background-color: transparent;
    border: none;
}
QComboBox#executablesListBox {
    min-height: 30px;
    max-height: 30px;
    padding: 0px 10px;
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
    border-radius: 4px;
}
QComboBox#executablesListBox:hover {
    background-color: @fieldHover@;
    border-color: @fieldLine@;
    border-bottom-color: @fieldBottom@;
}
QComboBox#executablesListBox:focus,
QComboBox#executablesListBox:on {
    border-color: @fieldLine@;
    border-bottom: 2px solid @accent@;
}
QToolButton#startButton,
QToolButton#refinedRunButton {
    min-width: 124px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px 0px 0px 12px;
    color: @accentFg@;
    background-color: @accent@;
    border: 1px solid @accent@;
    border-radius: 4px;
    font-weight: 600;
}
QToolButton#startButton:hover,
QToolButton#refinedRunButton:hover {
    background-color: @accentHover@;
    border-color: @accentHover@;
}
QToolButton#startButton:pressed,
QToolButton#refinedRunButton:pressed {
    color: @accentFgPressed@;
    background-color: @accentPressed@;
    border-color: @accentPressed@;
}
QToolButton#startButton:disabled,
QToolButton#refinedRunButton:disabled {
    color: @faint@;
    background-color: @disabledBg@;
    border-color: @line@;
}
QToolButton#startButton::menu-button,
QToolButton#refinedRunButton::menu-button {
    width: 30px;
    background-color: transparent;
    border: none;
    border-left: 1px solid @accentDivider@;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QToolButton#startButton::menu-arrow,
QToolButton#refinedRunButton::menu-arrow {
    image: url(./@assets@/chevron-down-accent.svg);
    width: 10px;
    height: 10px;
}

/* Main window: Data, Saves, and Downloads card with underline tabs. */
QTabWidget::pane,
QWidget#centralWidget QTabWidget#tabWidget::pane,
QDialog#SettingsDialog QTabWidget#tabWidget::pane,
QDialog#ModInfoDialog QTabWidget#tabWidget::pane {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 6px;
}
QTabBar,
QWidget#centralWidget QTabWidget#tabWidget QTabBar {
    background-color: transparent;
}
QTabBar::tab,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab {
    color: @muted@;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    min-width: 40px;
    min-height: 22px;
    padding: 7px 12px 5px 12px;
    margin: 0px 2px 0px 0px;
}
QTabBar::tab:hover,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab:hover,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab:hover,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab:hover {
    color: @text@;
    background-color: transparent;
    border-bottom-color: @line@;
}
QTabBar::tab:selected,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab:selected,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab:selected,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab:selected {
    color: @text@;
    background-color: transparent;
    border-bottom: 3px solid @accent@;
}

QWidget#dataTab QTreeView#dataTree,
QWidget#savesTab QTreeWidget#savegameList,
QWidget#downloadTab DownloadListView#downloadView,
QWidget#espTab PluginListView#espList,
QWidget#centralWidget QTabWidget#tabWidget QTreeView,
QWidget#centralWidget QTabWidget#tabWidget QTreeWidget {
    color: @text@;
    background-color: @card@;
    alternate-background-color: @rowAlt@;
    border: none;
    border-radius: 0px;
    gridline-color: @line@;
    selection-background-color: @sel@;
    selection-color: @text@;
}
QWidget#savesTab QTreeWidget#savegameList:focus,
QWidget#downloadTab DownloadListView#downloadView:focus {
    border: none;
}
QWidget#dataTab QTreeView#dataTree::item:hover {
    background-color: @rowHover@;
}
QWidget#dataTab QTreeView#dataTree::item:selected,
QWidget#dataTab QTreeView#dataTree::item:selected:focus,
QWidget#dataTab QTreeView#dataTree::item:hover:selected {
    color: @text@;
    background-color: @sel@;
}
QWidget#dataTab QTreeView#dataTree QHeaderView::section,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::section,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::section {
    min-height: 28px;
    padding: 6px 9px;
    color: @muted@;
    background-color: @card@;
    border: none;
    border-right: 1px solid @line@;
    border-bottom: 1px solid @line@;
    font-weight: 600;
}
QWidget#dataTab QTreeView#dataTree QHeaderView::section:hover,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::section:hover,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::section:hover {
    background-color: @rowHover@;
}
QHeaderView::up-arrow,
QWidget#dataTab QTreeView#dataTree QHeaderView::up-arrow,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::up-arrow,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::up-arrow {
    image: url(./@assets@/sort-up.svg);
}
QHeaderView::down-arrow,
QWidget#dataTab QTreeView#dataTree QHeaderView::down-arrow,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::down-arrow,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::down-arrow {
    image: url(./@assets@/sort-down.svg);
}

QWidget#dataTab QPushButton#dataTabRefresh,
QWidget#downloadTab QPushButton#btnRefreshDownloads,
QWidget#savesTab QPushButton#savesRefresh,
QWidget#savesTab QPushButton#savesOpenFolder,
QWidget#espTab QPushButton#sortButton {
    min-height: 30px;
    padding: 4px 12px;
    color: @text@;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
    border-radius: 4px;
    font-weight: 400;
}
QWidget#dataTab QPushButton#dataTabRefresh:hover,
QWidget#downloadTab QPushButton#btnRefreshDownloads:hover,
QWidget#savesTab QPushButton#savesRefresh:hover,
QWidget#savesTab QPushButton#savesOpenFolder:hover,
QWidget#espTab QPushButton#sortButton:hover {
    color: @text@;
    background-color: @btnHover@;
    border-color: @btnLine@;
    border-bottom-color: @btnBottom@;
}
QWidget#dataTab QPushButton#dataTabRefresh:pressed,
QWidget#downloadTab QPushButton#btnRefreshDownloads:pressed,
QWidget#savesTab QPushButton#savesRefresh:pressed,
QWidget#savesTab QPushButton#savesOpenFolder:pressed,
QWidget#espTab QPushButton#sortButton:pressed {
    color: @muted@;
    background-color: @btnPressed@;
}

/* Toggles in the tab footers render as Fluent switches. */
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts,
QWidget#dataTab QCheckBox#dataTabShowFromArchives,
QWidget#downloadTab QCheckBox#showHiddenBox,
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives:hover,
QWidget#downloadTab QCheckBox#showHiddenBox:hover,
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts:checked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives:checked,
QWidget#downloadTab QCheckBox#showHiddenBox:checked {
    min-height: 30px;
    padding: 3px 6px;
    spacing: 8px;
    color: @text@;
    background-color: transparent;
    border: none;
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator {
    width: 40px;
    height: 20px;
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:unchecked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:unchecked,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:unchecked {
    image: url(./@assets@/switch-off.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:unchecked:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:unchecked:hover,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:unchecked:hover {
    image: url(./@assets@/switch-off-hover.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:checked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:checked,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:checked {
    image: url(./@assets@/switch-on.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:checked:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:checked:hover,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:checked:hover {
    image: url(./@assets@/switch-on-hover.svg);
}
QWidget#dataTab QLineEdit#dataTabFilter,
QWidget#downloadTab QLineEdit#downloadFilterEdit {
    min-height: 30px;
    padding: 4px 10px;
    color: @text@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-bottom: 1px solid @fieldBottom@;
    border-radius: 4px;
}
QWidget#dataTab QLineEdit#dataTabFilter:focus,
QWidget#downloadTab QLineEdit#downloadFilterEdit:focus {
    border-color: @fieldLine@;
    border-bottom: 2px solid @accent@;
}

/* Log and status bar. */
QDockWidget#logDock {
    color: @text@;
    background-color: @bg@;
    border: none;
}
QWidget#logDockTitleBar {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-bottom: 1px solid @line@;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QLabel#logDockTitleLabel {
    color: @text@;
}
QToolButton#logDockCloseButton,
QToolButton#logDockFloatButton {
    color: @muted@;
    border-radius: 4px;
}
QToolButton#logDockCloseButton:hover,
QToolButton#logDockFloatButton:hover {
    background-color: @hover@;
}
QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: @bg@;
}
QDockWidget#logDock QTreeView#logList {
    color: @text@;
    background-color: @card@;
    alternate-background-color: @rowAlt@;
    selection-color: @text@;
    selection-background-color: @sel@;
    border: 1px solid @cardLine@;
    border-top: none;
    border-radius: 0px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDockWidget#logDock QTreeView#logList::item:hover:!selected {
    background-color: @rowHover@;
}
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    color: @text@;
    background-color: @sel@;
}

QStatusBar {
    color: @muted@;
    background-color: @bg@;
    border-top: 1px solid @line@;
}
QStatusBar QLabel#apistats {
    border-radius: 4px;
}
QStatusBar QLabel#apistats[apiState="warning"] {
    color: @warnFg@;
    background-color: @warnBg@;
    border: 1px solid @warnBg@;
}

/* ----------------------------------------------------------------------
   Fluent v4 main window structure (cards, Run row, expander). These
   object names exist only in the Fluent build of mainwindow.ui; older
   builds ignore the rules.
   ---------------------------------------------------------------------- */

/* Run row at the top of the Data card, the same height as the profile row
   of the mod list card so both cards line up. */
QFrame[fluentCard="true"] QFrame#startGroup {
    background-color: transparent;
    border: none;
}

QFrame[fluentCard="true"] {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
}
QFrame[fluentCard="true"] QLabel {
    background-color: transparent;
}
QMainWindow#MainWindow QFrame[fluentCard="true"] QTreeView#modList {
    background-color: @card@;
    border: none;
    border-top: 1px solid @line@;
    border-bottom: 1px solid @line@;
    border-radius: 0px;
}
QFrame[fluentCard="true"] QTabWidget::pane,
QWidget#centralWidget QFrame[fluentCard="true"] QTabWidget#tabWidget::pane {
    background-color: @card@;
    border: none;
    border-top: 1px solid @line@;
    border-radius: 0px;
    top: 0px;
}
QFrame[fluentCard="true"] QTabWidget::tab-bar {
    left: 0px;
}

FluentTabBar {
    qproperty-indicatorColor: @accent@;
    background-color: transparent;
}
FluentTabBar::tab,
FluentTabBar::tab:hover,
FluentTabBar::tab:selected {
    border-bottom: 3px solid transparent;
}
FluentTabBar::tab:hover:!selected {
    color: @text@;
}

/* Glyph buttons: the icon font has to come from here, since the QWidget rule
   above overrides fonts set in code; in the text font Qt searches every
   installed font for the glyph and logs DirectWrite errors on the old ones. */
QMainWindow#MainWindow QToolButton#moreActionsBtn {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 15px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
    color: @text@;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn:hover {
    background-color: @hover@;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn:pressed,
QMainWindow#MainWindow QToolButton#moreActionsBtn:open {
    background-color: @pressed@;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn::menu-indicator {
    image: none;
    width: 0px;
}
QMainWindow#MainWindow QLabel#activeModslabel {
    color: @muted@;
    padding-left: 6px;
}

/* Run button states: Mounting and Starting keep the accent, Running turns green. */
QToolButton#startButton[runState="busy"],
QToolButton#startButton[runState="busy"]:disabled {
    color: @accentFg@;
    background-color: @accentBusy@;
    border-color: @accentBusy@;
}
QToolButton#startButton[runState="running"],
QToolButton#startButton[runState="running"]:disabled {
    color: @runningFg@;
    background-color: @running@;
    border-color: @running@;
}

/* Log expander row. */
QWidget#logDockTitleBar {
    min-height: 34px;
    max-height: 34px;
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
}
QDockWidget#logDock QWidget#logDockTitleBar {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
QLabel#logDockSummaryLabel {
    color: @muted@;
    background-color: transparent;
    padding-left: 6px;
}
QToolButton#logDockExpandButton {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 8pt;
    color: @muted@;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QToolButton#logDockExpandButton:hover {
    color: @text@;
    background-color: @hover@;
}

/* The animated pill replaces the stylesheet underline in the main window. */
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab,
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab:hover,
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab:selected {
    border-bottom: 3px solid transparent;
}

/* Animated mod list switches (ModListView paints them with these colors). */
QMainWindow#MainWindow ModListView#modList {
    qproperty-switchOnColor: @accent@;
    qproperty-switchOffColor: @trackOff@;
    qproperty-switchBorderColor: @trackLine@;
    qproperty-switchKnobOnColor: @knobOn@;
    qproperty-switchKnobOffColor: @knobOff@;
}

/* Card interiors: the tab widget, its pages, and the stacked widget between
   them are transparent so the card surface shows through. */
QFrame[fluentCard="true"] QTabWidget,
QFrame[fluentCard="true"] QStackedWidget,
QWidget#centralWidget QTabWidget#tabWidget QStackedWidget > QWidget {
    background-color: transparent;
}

/* Command bar menus: the chevron sits on the text line at the right edge. */
QMainWindow#MainWindow QToolBar#toolBar QToolButton[popupMode="2"] {
    padding-right: 18px;
}
/* the overflow button is "...": no chevron next to it */
QMainWindow#MainWindow QToolBar#toolBar QToolButton#actionFluentMore,
QMainWindow#MainWindow QToolBar#toolBar QToolButton[popupMode="2"]#actionFluentMore {
    padding-right: 8px;
}
QMainWindow#MainWindow QToolBar#toolBar QToolButton#actionFluentMore::menu-indicator {
    image: none;
    width: 0px;
}
QMainWindow#MainWindow QToolBar#toolBar QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    bottom: 0px;
}

/* Footer rows and tab toolbars share the 32px line of the top rows: no
   vertical padding plus a 1px border. A focused field draws a 2px accent edge,
   so its content shrinks by 1px to keep the same outer height. */
QMainWindow#MainWindow QPushButton#displayCategoriesBtn,
QMainWindow#MainWindow QPushButton#clearFiltersButton,
QMainWindow#MainWindow QComboBox#groupCombo,
QMainWindow#MainWindow QLineEdit#modFilterEdit,
QWidget#dataTab QLineEdit#dataTabFilter,
QWidget#downloadTab QLineEdit#downloadFilterEdit,
QWidget#dataTab QPushButton#dataTabRefresh,
QWidget#downloadTab QPushButton#btnRefreshDownloads,
QWidget#savesTab QPushButton#savesRefresh,
QWidget#savesTab QPushButton#savesOpenFolder,
QWidget#espTab QPushButton#sortButton {
    min-height: 30px;
    max-height: 30px;
    padding-top: 0px;
    padding-bottom: 0px;
}
QMainWindow#MainWindow QComboBox#groupCombo:focus,
QMainWindow#MainWindow QLineEdit#modFilterEdit:focus,
QWidget#dataTab QLineEdit#dataTabFilter:focus,
QWidget#downloadTab QLineEdit#downloadFilterEdit:focus,
QMainWindow#MainWindow QComboBox#profileBox:focus,
QComboBox#executablesListBox:focus,
QComboBox#executablesListBox:on {
    min-height: 29px;
    max-height: 29px;
    padding-top: 0px;
    padding-bottom: 0px;
}

/* Mica: on Windows 11 the main window is translucent and MOApplication sets
   fluentMica, so the window surfaces between the cards let the system
   backdrop through. The cards, lists and fields keep their own fill. */
QMainWindow#MainWindow[fluentMica="true"],
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#categoriesSplitter,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle:hover,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle:pressed,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitterHandle,
QMainWindow#MainWindow[fluentMica="true"]::separator,
QMainWindow#MainWindow[fluentMica="true"] QMenuBar#menuBar,
QMainWindow#MainWindow[fluentMica="true"] QToolBar#toolBar,
QMainWindow#MainWindow[fluentMica="true"] QToolBar#toolBar > QWidget,
QMainWindow#MainWindow[fluentMica="true"] QStatusBar#statusBar,
QMainWindow#MainWindow[fluentMica="true"] QStatusBar#statusBar QLabel,
QMainWindow#MainWindow[fluentMica="true"] QDockWidget#logDock,
QMainWindow#MainWindow[fluentMica="true"] QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: transparent;
}

/* Game bar: the game, the pickers, last played and Run. */
QFrame#fluentHero {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
}
QLabel#fluentHeroTitle {
    color: @text@;
    font-size: 12pt;
    font-weight: 600;
    background-color: transparent;
}
QLabel#fluentHeroLabel {
    color: @muted@;
    background-color: transparent;
}
QLabel#fluentHeroLogo {
    background-color: transparent;
}

/* Summary row below the header. */
QFrame#fluentStatTile {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
}
QFrame#fluentStatTile QLabel {
    background-color: transparent;
}
QLabel#fluentStatBadge {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 13pt;
    border-radius: 8px;
    color: @muted@;
    background-color: @fieldLine@;
}
QLabel#fluentStatBadge[tone="accent"] {
    color: @accentText@;
    background-color: @accentSubtle@;
}
QLabel#fluentStatBadge[tone="caution"] {
    color: @warnFg@;
    background-color: @warnBg@;
}
QLabel#fluentStatBadge[tone="critical"] {
    color: @critFg@;
    background-color: @critBg@;
}
QLabel#fluentStatCaption {
    color: @caption@;
}
QLabel#fluentStatValue {
    color: @text@;
    font-size: 12pt;
    font-weight: 600;
}
QPushButton#fluentStatAction,
QPushButton#fluentFilterChip {
    min-height: 26px;
    max-height: 26px;
    padding: 0px 14px;
    color: @muted@;
    background-color: @field@;
    border: 1px solid @fieldLine@;
    border-radius: 13px;
}
QPushButton#fluentStatAction:hover,
QPushButton#fluentFilterChip:hover {
    color: @text@;
    background-color: @fieldHover@;
}
QPushButton#fluentFilterChip:checked {
    color: @accentText@;
    background-color: @accentSubtle@;
    border-color: @accentDivider@;
}

/* Mods card title. */
QLabel#fluentCardTitle {
    color: @text@;
    font-size: 12pt;
    font-weight: 600;
}

/* Settings-style navigation (FluentNavigation): the list paints its own
   rows; the pages lose the tab pane frame. */
QListWidget#fluentNav,
QListWidget#fluentNav:focus {
    background-color: transparent;
    border: none;
    outline: none;
}
QWidget#fluentNavPage {
    background-color: transparent;
}
QTabWidget[fluentNavigation="true"] > QStackedWidget,
QTabWidget[fluentNavigation="true"] > QStackedWidget > QWidget {
    background-color: transparent;
}
QTabWidget[fluentNavigation="true"]::pane {
    border: none;
    background-color: transparent;
    top: 0px;
}

/* Settings rows (FluentSettings): title and description on the left, a
   toggle switch on the right, hairlines between the rows of a card. */
QFrame#fluentSettingRow {
    background-color: transparent;
    border: none;
    border-top: 1px solid @line@;
}
QFrame#fluentSettingRow:hover {
    background-color: @rowHover@;
}
QLabel#fluentSettingTitle {
    color: @text@;
    background-color: transparent;
}
QLabel#fluentSettingDescription {
    color: @caption@;
    font-size: 8.5pt;
    background-color: transparent;
}
QLabel#fluentSettingTitle:disabled,
QLabel#fluentSettingDescription:disabled {
    color: @disabledLine@;
}
QCheckBox[fluentSwitch="true"] {
    spacing: 0px;
    background-color: transparent;
}
QCheckBox[fluentSwitch="true"]::indicator,
QCheckBox[fluentSwitch="true"]::indicator:unchecked {
    width: 40px;
    height: 20px;
    image: url(./@assets@/switch-off.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:unchecked:hover {
    image: url(./@assets@/switch-off-hover.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked {
    image: url(./@assets@/switch-on.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked:hover {
    image: url(./@assets@/switch-on-hover.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:unchecked:disabled {
    image: url(./@assets@/switch-off-disabled.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked:disabled {
    image: url(./@assets@/switch-on-disabled.svg);
}
QFrame#fluentSettingRow[fluentGridRow="true"] {
    border-top: none;
}

/* Animated switches: FluentSwitchPainter draws them in these colors over the
   indicator, so the still images above are hidden. */
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked:hover,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked:hover,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked:disabled,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked:disabled {
    image: none;
}
FluentSwitchPainter {
    qproperty-onColor: @accent@;
    qproperty-offColor: @trackOff@;
    qproperty-borderColor: @trackLine@;
    qproperty-knobOnColor: @knobOn@;
    qproperty-knobOffColor: @knobOff@;
}

/* Settings controls at the Windows 11 size: 32px fields, buttons and lists
   (the page-specific rules of the base theme made them up to 44px). */
QDialog#SettingsDialog QWidget#fluentNavPage QPushButton {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 16px;
    border-radius: 4px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QLineEdit {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 10px;
    border-radius: 4px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QComboBox {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 10px;
    border-radius: 4px;
}

/* Settings pages share the window surface with the navigation: no darker
   page panel behind the cards. */
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#generalTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#themeTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#uiTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#pathsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#nexusTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#pluginsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#workaroundTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#diagnosticsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QStackedWidget#qt_tabwidget_stackedwidget,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea > QWidget#qt_scrollarea_viewport,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea > QWidget#qt_scrollarea_viewport > QWidget,
QDialog#SettingsDialog QWidget#fluentPageContent {
    background-color: transparent;
    border: none;
}
QDialog#SettingsDialog QWidget#fluentNavPage QFrame#fluentSettingRow QLabel#fluentSettingTitle {
    font-weight: normal;
    padding: 0px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QLabel#fluentSettingSubheading {
    color: @muted@;
    font-weight: 600;
    padding: 10px 4px 2px 4px;
    background-color: transparent;
}

/* About MO2 Revamped (python plugin): pivot tabs like the rest of Fluent. */
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs::pane {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
    top: -1px;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab {
    color: @muted@;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    min-height: 22px;
    padding: 7px 12px 5px 12px;
    margin: 0px 2px 0px 0px;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab:hover {
    color: @text@;
    background-color: transparent;
    border-bottom-color: @line@;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab:selected {
    color: @text@;
    background-color: transparent;
    border-bottom: 3px solid @accent@;
}

/* About: the program logo stands on its own, without the round badge. */
QDialog#MO2RevampedAboutDialog QLabel#mo2RevampedAboutLogo {
    background-color: transparent;
    border: none;
    padding: 0px;
}

/* Dialogs: every button and field at the Windows 11 height of 32px. These
   generic rules replace the classic per-dialog looks, which the generator
   drops, and the per-widget style sheets FluentDialogs used to set. */
QDialog QPushButton {
    min-height: 20px;
    padding: 5px 14px;
    font-weight: normal;
}
QDialog QDialogButtonBox QPushButton {
    min-width: 72px;
}
QDialog QPushButton:default {
    color: @text@;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
}
QDialog QPushButton:default:hover {
    background-color: @btnHover@;
}
QDialog QPushButton:default:pressed {
    color: @muted@;
    background-color: @btnPressed@;
    border-bottom-color: @btnLine@;
}
QDialog QPushButton[fluentPrimary="true"],
QMessageBox QPushButton:default {
    color: @accentFg@;
    background-color: @accent@;
    border: 1px solid @accent@;
}
QDialog QPushButton[fluentPrimary="true"]:hover,
QMessageBox QPushButton:default:hover {
    background-color: @accentHover@;
    border-color: @accentHover@;
}
QDialog QPushButton[fluentPrimary="true"]:pressed,
QMessageBox QPushButton:default:pressed {
    color: @accentFgPressed@;
    background-color: @accentPressed@;
    border-color: @accentPressed@;
}
QDialog QPushButton:default:disabled,
QDialog QPushButton[fluentPrimary="true"]:disabled {
    color: @faint@;
    background-color: @disabledBg@;
    border-color: @line@;
}
QDialog QLineEdit, QDialog QComboBox, QDialog QAbstractSpinBox {
    min-height: 22px;
    padding: 4px 10px;
}
QDialog QComboBox:focus, QDialog QLineEdit:focus, QDialog QAbstractSpinBox:focus {
    padding-bottom: 3px;
}
/* editors inside lists, combo boxes and spin boxes keep the row's height */
QDialog QAbstractItemView QLineEdit, QDialog QAbstractItemView QComboBox,
QDialog QAbstractItemView QAbstractSpinBox,
QDialog QComboBox QLineEdit, QDialog QAbstractSpinBox QLineEdit {
    min-height: 0px;
    padding: 0px 2px;
}
QDialog QComboBox QLineEdit, QDialog QAbstractSpinBox QLineEdit,
QDialog QComboBox QLineEdit:focus, QDialog QAbstractSpinBox QLineEdit:focus {
    border: none;
    background-color: transparent;
}

/* text buttons built as tool buttons (split "Add" buttons, list actions) */
QDialog QToolButton[fluentButton="true"] {
    color: @text@;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
    border-radius: 4px;
    min-height: 20px;
    padding: 5px 8px;
}
QDialog QToolButton[fluentButton="true"]:hover {
    background-color: @btnHover@;
}
QDialog QToolButton[fluentButton="true"]:pressed {
    color: @muted@;
    background-color: @btnPressed@;
    border-bottom-color: @btnLine@;
}
QDialog QToolButton[fluentButton="true"]:disabled {
    color: @faint@;
    background-color: @disabledBg@;
    border-color: @line@;
}
QDialog QToolButton[fluentButton="true"]::menu-button {
    width: 22px;
    border: none;
    border-left: 1px solid @btnLine@;
}

/* scrolling pages of dialogs share the dialog surface */
QDialog QScrollArea, QDialog QScrollArea > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
    border: none;
}
QDialog QGroupBox {
    background-color: @card@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
    margin-top: 22px;
    padding: 10px 10px 8px 10px;
    font-weight: 600;
}
QDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0px 2px 4px 2px;
    color: @text@;
}
QDialog QGroupBox > QWidget {
    font-weight: normal;
}

/* Mod information, Nexus page: the installed version in the status tones */
QDialog#ModInfoDialog QLineEdit#version[versionState="outdated"] {
    color: @critFg@;
}
QDialog#ModInfoDialog QLineEdit#version[versionState="current"] {
    color: @running@;
}

/* Filter options: its buttons came from the main window, whose sizes would
   follow them here */
QDialog#filterOptionsDialog QPushButton#filtersClear,
QDialog#filterOptionsDialog QPushButton#filtersEdit {
    min-height: 20px;
    max-height: 20px;
    padding: 5px 12px;
}
QDialog#filterOptionsDialog QComboBox#filtersSeparators {
    min-height: 22px;
    max-height: 22px;
}

/* Notifications: the guided fix is the dialog's primary action */
QDialog QPushButton#fixButton,
QDialog QPushButton#manageOverwriteButton {
    color: @accentFg@;
    background-color: @accent@;
    border: 1px solid @accent@;
    font-weight: normal;
}
QDialog QPushButton#fixButton:hover,
QDialog QPushButton#manageOverwriteButton:hover {
    background-color: @accentHover@;
    border-color: @accentHover@;
}
QDialog QPushButton#fixButton:pressed,
QDialog QPushButton#manageOverwriteButton:pressed {
    color: @accentFgPressed@;
    background-color: @accentPressed@;
    border-color: @accentPressed@;
}

/* ----------------------------------------------------------------------
   Instance manager: the list card on the left, the details card on the
   right (name, folder rows, actions), Switch and Close below.
   ---------------------------------------------------------------------- */
QListView#instanceList,
QListView#instanceList:focus {
    background-color: transparent;
    border: none;
    outline: none;
}
QLabel#instanceDetailName {
    color: @text@;
    font-size: 15pt;
    font-weight: 600;
    background-color: transparent;
}
QLabel#instanceDetailCaption,
QLabel#instanceDetailValue {
    color: @muted@;
    background-color: transparent;
}
QLabel#instanceDetailValue[tone="critical"] {
    color: @critFg@;
}
QScrollArea#instanceDetailsScroll,
QScrollArea#instanceDetailsScroll > QWidget > QWidget,
QWidget#instanceDetailRows {
    background-color: transparent;
    border: none;
}
QToolButton#instanceIconButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
}
QDialog#InstanceManagerDialog QPushButton#deleteInstance {
    color: @critFg@;
}
QDialog#InstanceManagerDialog QPushButton#deleteInstance:disabled {
    color: @faint@;
}
/* the grouping button: its text, then a chevron the button paints itself
   (it turns while the menu is open), so Qt's arrow is hidden */
QToolButton#instanceViewButton {
    color: @muted@;
    padding: 3px 22px 3px 8px;
}
QToolButton#instanceViewButton:hover,
QToolButton#instanceViewButton:open {
    color: @text@;
}
QToolButton#instanceViewButton::menu-indicator {
    image: none;
    width: 0px;
}
QToolButton#instanceHelpButton {
    color: @muted@;
    padding: 5px 8px;
}
QToolButton#instanceHelpButton:hover {
    color: @text@;
}
QLabel#instanceRowGlyph {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 12pt;
    color: @muted@;
    background-color: transparent;
}
QLabel#instanceEmptyText {
    color: @caption@;
    background-color: transparent;
}

/* Windows 11 content dialogs (FluentContentDialog): the content on the card
   surface, the buttons in a darker band below. */
QDialog[fluentContentDialog="true"],
QDialog[fluentContentDialog="true"] QWidget#fluentDialogContent {
    background-color: @card@;
}
QLabel#fluentDialogTitle {
    color: @text@;
    font-size: 15pt;
    font-weight: 600;
    background-color: transparent;
}
QLabel#fluentDialogText {
    color: @text@;
    background-color: transparent;
}
QFrame#fluentDialogFooter {
    background-color: @bg@;
    border: none;
    border-top: 1px solid @line@;
}
QLabel#instanceNameValidation {
    color: @critFg@;
    background-color: transparent;
}
QScrollArea#deleteInstanceScroll {
    background-color: @bg@;
    border: 1px solid @cardLine@;
    border-radius: 8px;
}
QScrollArea#deleteInstanceScroll > QWidget > QWidget,
QFrame#deleteInstanceList {
    background-color: transparent;
}
QFrame#instanceHelpExample {
    background-color: @bg@;
    border: 1px solid @cardLine@;
    border-radius: 6px;
}
QFrame#instanceHelpExample QLabel {
    background-color: transparent;
}

/* ----------------------------------------------------------------------
   Create instance wizard: laid out like the instance manager. One card
   with a thin progress line on top, each step's title and text, then rows
   divided by hairlines; the step count and the buttons under the card.
   ---------------------------------------------------------------------- */
QDialog#CreateInstanceDialog QStackedWidget#pages,
QDialog#CreateInstanceDialog QStackedWidget#pages > QWidget,
QDialog#CreateInstanceDialog QStackedWidget#pathPages,
QDialog#CreateInstanceDialog QStackedWidget#pathPages > QWidget,
QDialog#CreateInstanceDialog QWidget#wizardPageTop,
QDialog#CreateInstanceDialog QWidget#wizardPadded,
QDialog#CreateInstanceDialog QWidget#widget_9,
QDialog#CreateInstanceDialog QWidget#detectedPrograms,
QDialog#CreateInstanceDialog QWidget#widget_13,
QDialog#CreateInstanceDialog QWidget#widget_15,
QDialog#CreateInstanceDialog QWidget#widget_19,
QDialog#CreateInstanceDialog QWidget#widget_25,
QDialog#CreateInstanceDialog QWidget#review,
QDialog#CreateInstanceDialog QDialogButtonBox#editions {
    background-color: transparent;
    border: none;
}
/* each step scrolls inside the card if it's ever taller than it */
QDialog#CreateInstanceDialog QScrollArea#wizardPageScroll,
QDialog#CreateInstanceDialog QScrollArea#wizardPageScroll > QWidget,
QDialog#CreateInstanceDialog QScrollArea#wizardPageScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}
/* how full the drive under the location is */
QProgressBar#wizardDiskBar {
    background-color: @line@;
    border: none;
    border-radius: 2px;
}
QProgressBar#wizardDiskBar::chunk {
    background-color: @accent@;
    border-radius: 2px;
}
/* the storage kinds side by side */
QLabel[wizardCompare="head"] {
    color: @text@;
    font-weight: 600;
    background-color: transparent;
}
QLabel[wizardCompare="key"] {
    color: @muted@;
    background-color: transparent;
}
QLabel[wizardCompare="cell"] {
    color: @text@;
    background-color: transparent;
}
QProgressBar#wizardProgress {
    background-color: @line@;
    border: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QProgressBar#wizardProgress::chunk {
    background-color: @accent@;
    border-top-left-radius: 7px;
}
QLabel[wizardPageTitle="true"] {
    color: @text@;
    font-size: 15pt;
    font-weight: 600;
    background-color: transparent;
}
QLabel[wizardPageText="true"] {
    color: @muted@;
    background-color: transparent;
}
QLabel[wizardRowText="true"],
QLabel#wizardNamePath,
QLabel#diskSpace,
QLabel#label_11 {
    color: @caption@;
    font-size: 8.5pt;
    background-color: transparent;
}
QLabel#wizardStepText {
    color: @muted@;
    background-color: transparent;
}
QLabel[wizardFieldCaption="true"] {
    color: @text@;
    background-color: transparent;
}

/* choices: storage types, editions and games are rows of the card; the
   chosen one is filled and marked by the accent on its left edge */
QDialog#CreateInstanceDialog QCommandLinkButton[wizardChoice="true"],
QDialog#CreateInstanceDialog QCommandLinkButton#gameChoice {
    color: @text@;
    background-color: transparent;
    border: none;
    border-top: 1px solid @line@;
    border-left: 3px solid transparent;
    border-radius: 0px;
    padding: 12px 20px 12px 17px;
    text-align: left;
}
QDialog#CreateInstanceDialog QCommandLinkButton[wizardChoice="true"]:hover,
QDialog#CreateInstanceDialog QCommandLinkButton#gameChoice:hover {
    background-color: @rowHover@;
}
QDialog#CreateInstanceDialog QCommandLinkButton[wizardChoice="true"]:pressed,
QDialog#CreateInstanceDialog QCommandLinkButton#gameChoice:pressed {
    background-color: @pressed@;
}
QDialog#CreateInstanceDialog QCommandLinkButton[wizardChoice="true"]:checked,
QDialog#CreateInstanceDialog QCommandLinkButton#gameChoice:checked {
    background-color: @sel@;
    border-left-color: @accent@;
}
QDialog#CreateInstanceDialog QScrollArea#scrollArea_3,
QDialog#CreateInstanceDialog QScrollArea#scrollArea_3 > QWidget,
QDialog#CreateInstanceDialog QWidget#games {
    background-color: transparent;
    border: none;
}

/* switches: their text a little away from the switch; the profile options
   are rows with their explanation under the text */
QDialog#CreateInstanceDialog QCheckBox[fluentSwitch="true"] {
    spacing: 12px;
}
QDialog#CreateInstanceDialog QCheckBox[wizardOption="true"] {
    padding: 12px 20px 2px 20px;
    border-top: 1px solid @line@;
}
QLabel[wizardOptionText="true"] {
    color: @caption@;
    font-size: 8.5pt;
    padding: 0px 20px 12px 72px;
    background-color: transparent;
}

/* warnings and errors under a field */
QLabel[wizardInfoBar="caution"] {
    color: @warnFg@;
    background-color: @warnBg@;
    border-radius: 4px;
    padding: 8px 12px;
}
QLabel[wizardInfoBar="critical"] {
    color: @critFg@;
    background-color: @critBg@;
    border-radius: 4px;
    padding: 8px 12px;
}

/* the folder buttons next to the path fields */
QDialog#CreateInstanceDialog QToolButton[wizardBrowse="true"] {
    min-width: 30px;
    min-height: 28px;
    padding: 0px 4px;
    background-color: @btn@;
    border: 1px solid @btnLine@;
    border-bottom-color: @btnBottom@;
    border-radius: 4px;
}
QDialog#CreateInstanceDialog QToolButton[wizardBrowse="true"]:hover {
    background-color: @btnHover@;
}
QDialog#CreateInstanceDialog QToolButton[wizardBrowse="true"]:pressed {
    background-color: @btnPressed@;
}

/* the review: caption, value and Change, like the instance manager's rows */
QLabel#wizardReviewKey {
    color: @muted@;
    background-color: transparent;
}
QLabel#wizardReviewValue {
    color: @text@;
    background-color: transparent;
}
QToolButton#wizardChangeButton {
    color: @accentText@;
    padding: 2px 8px;
}
QDialog#CreateInstanceDialog QListWidget#nexusLog,
QDialog#CreateInstanceDialog QTextEdit#creationLog {
    background-color: @bg@;
    border: 1px solid @cardLine@;
    border-radius: 6px;
}
