    border-radius: 13px;
}
QDialog#CategoriesDialog QLabel#categoryCardTitle {
    color: #DBDBDB;
    background-color: transparent;
    border: none;
    font-size: 10pt;
    font-weight: 600;
}
QDialog#CategoriesDialog QTableWidget#categoriesTable,
QDialog#CategoriesDialog QListWidget#nexusCategoryList {
    color: #DBDBDB;
    background-color: #202020;
    alternate-background-color: #242424;
    selection-color: #EBEBEB;
    selection-background-color: #2A2A2A;
    border: 1px solid #2E2E2E;
    border-radius: 7px;
    gridline-color: #3C3C3C;
    outline: none;
    padding: 3px;
}
QDialog#CategoriesDialog QTableWidget#categoriesTable QHeaderView::section {
    min-height: 28px;
    padding: 5px 9px;
    color: #CECECE;
    background-color: #272727;
    border: none;
    border-right: 1px solid #2E2E2E;
    border-bottom: 1px solid #2E2E2E;
    font-weight: 600;
}
QDialog#CategoriesDialog QTableWidget#categoriesTable::item,
QDialog#CategoriesDialog QListWidget#nexusCategoryList::item {
    min-height: 23px;
    padding: 4px 8px;
    margin: 0;
    border: none;
}
QDialog#CategoriesDialog QTableWidget#categoriesTable::item:hover:!selected,
QDialog#CategoriesDialog QListWidget#nexusCategoryList::item:hover:!selected {
    background-color: #272727;
}
QDialog#CategoriesDialog QTableWidget#categoriesTable::item:selected,
QDialog#CategoriesDialog QListWidget#nexusCategoryList::item:selected {
    color: #EBEBEB;
    background-color: #2A2A2A;
}
QDialog#CategoriesDialog QLineEdit {
    color: #DBDBDB;
    background-color: #202020;
    selection-color: #EBEBEB;
    selection-background-color: #2A2A2A;
    border: 1px solid #333333;
    border-radius: 5px;
    padding: 4px 7px;
}
QDialog#CategoriesDialog QPushButton#addCategoryButton,
QDialog#CategoriesDialog QPushButton#nexusImportButton {
    min-height: 32px;
    padding: 5px 12px;
    color: #EBEBEB;
    background-color: #2A2A2A;
    border: 1px solid #7B7B7B;
    border-radius: 7px;
    font-weight: 600;
}
QDialog#CategoriesDialog QPushButton#addCategoryButton:hover,
QDialog#CategoriesDialog QPushButton#nexusImportButton:hover {
    background-color: #2D2D2D;
    border-color: #8F8F8F;
}
QDialog#CategoriesDialog QPushButton#removeCategoryButton,
QDialog#CategoriesDialog QPushButton#nexusRefresh,
QDialog#CategoriesDialog QDialogButtonBox#buttonBox QPushButton {
    min-height: 32px;
    padding: 5px 12px;
    color: #DBDBDB;
    background-color: #262626;
    border: 1px solid #303030;
    border-radius: 7px;
}
QDialog#CategoriesDialog QPushButton#removeCategoryButton:hover,
QDialog#CategoriesDialog QPushButton#nexusRefresh:hover,
QDialog#CategoriesDialog QDialogButtonBox#buttonBox QPushButton:hover {
    background-color: #2A2A2A;
    border-color: #767676;
}
QDialog#CategoriesDialog QPushButton#removeCategoryButton:disabled,
QDialog#CategoriesDialog QPushButton#nexusRefresh:disabled,
QDialog#CategoriesDialog QPushButton#nexusImportButton:disabled {
    color: #818181;
    background-color: #262626;
    border-color: #2C2C2C;
}
QDialog#CategoriesDialog QDialogButtonBox#buttonBox {
    background-color: transparent;
    border: none;
}

/* Log dock and status strip: keep diagnostic rows readable without a hard selection band. */
QDockWidget#logDock {
    color: #DBDBDB;
    background-color: #202020;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QWidget#logDockTitleBar {
    min-height: 34px;
    max-height: 34px;
    background-color: #202020;
    border: none;
    border-bottom: 1px solid #292929;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QLabel#logDockTitleLabel {
    color: #CECECE;
    font-weight: 600;
    background-color: transparent;
    border: none;
    padding: 0;
}
QToolButton#logDockCloseButton,
QToolButton#logDockFloatButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #C2C2C2;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 0;
    padding: 0;
}
QToolButton#logDockCloseButton:hover,
QToolButton#logDockFloatButton:hover {
    background-color: transparent;
    border-color: transparent;
}
QToolButton#logDockCloseButton:pressed,
QToolButton#logDockFloatButton:pressed {
    background-color: transparent;
    border-color: transparent;
}
QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: #202020;
    border: none;
}
QDockWidget#logDock QTreeView#logList {
    color: #DBDBDB;
    background-color: #202020;
    alternate-background-color: #242424;
    selection-color: #EBEBEB;
    selection-background-color: #2A2A2A;
    border: 1px solid #2E2E2E;
    border-radius: 7px;
    outline: none;
    padding: 2px;
}
QDockWidget#logDock QTreeView#logList::item,
QDockWidget#logDock QTreeView#logList::item:hover,
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:focus,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    min-height: 19px;
    padding: 3px 8px;
    margin: 0;
    border: none;
}
QDockWidget#logDock QTreeView#logList::item:hover:!selected {
    background-color: #272727;
}
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    color: #EBEBEB;
    background-color: #2A2A2A;
}
QStatusBar {
    color: #BCBCBC;
    background-color: #252525;
    border-top: 1px solid #2E2E2E;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel#apistats {
    margin: 2px 4px;
    padding: 2px 8px;
    border-radius: 5px;
    font-weight: 600;
}
QStatusBar QLabel#apistats[apiState="offline"] {
    color: #BCBCBC;
    background-color: transparent;
    border: none;
}
QStatusBar QLabel#apistats[apiState="healthy"] {
    color: #C3E2CC;
    background-color: #274233;
    border: 1px solid #3C6950;
}
QStatusBar QLabel#apistats[apiState="warning"] {
    color: #F0DDA4;
    background-color: #493F27;
    border: 1px solid #756232;
}
QStatusBar QLabel#apistats[apiState="low"] {
    color: #F2C4C1;
    background-color: #4A3031;
    border: 1px solid #7B4D4A;
}

/* MO2 Revamped Elden Ring archive layout installer. */
QDialog#EldenRingArchiveLayoutDialog {
    color: #DBDBDB;
    background-color: #242424;
}
QDialog#EldenRingArchiveLayoutDialog QScrollArea#archiveContentScrollArea,
QDialog#EldenRingArchiveLayoutDialog QWidget#archiveDialogContent {
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveHeaderPanel {
    background-color: #272727;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveHeaderBadge {
    color: #EEEEEE;
    background-color: #2C2C2C;
    border: 1px solid #7E7E7E;
    border-radius: 21px;
    font-size: 10pt;
    font-weight: 700;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePageTitle {
    color: #EEEEEE;
    background-color: transparent;
    border: none;
    font-size: 14pt;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePageSubtitle,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveSectionDescription,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveFooterNote,
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePreviewNote {
    color: #B3B3B3;
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveNameCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveTextFilesCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archivePackagePathsCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveLayoutChoiceCard {
    color: #DBDBDB;
    background-color: #252525;
    border: 1px solid #2D2D2D;
    border-radius: 7px;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveLayoutChoiceCard[preferredChoice="true"] {
    background-color: #272727;
    border: 1px solid #7E7E7E;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveSectionTitle,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceTitle {
    color: #E8E8E8;
    background-color: transparent;
    border: none;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceTitle {
    font-size: 11pt;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceDescription {
    color: #C3C3C3;
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveFieldLabel {
    color: #DBDBDB;
    background-color: transparent;
    border: none;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLineEdit#archiveModNameEdit {
    color: #E4E4E4;
    background-color: #242424;
    border: 1px solid #2F2F2F;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 22px;
}
QDialog#EldenRingArchiveLayoutDialog QLineEdit#archiveModNameEdit:focus {
    border-color: #7E7E7E;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton {
    color: #DBDBDB;
    background-color: #262626;
    border: 1px solid #2F2F2F;
    border-radius: 6px;
    padding: 6px 12px;
    text-align: left;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton:hover {
    background-color: #272727;
    border-color: #676767;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton:checked {
    background-color: #282828;
    border-color: #7E7E7E;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton {
    color: #DBDBDB;
    background-color: #272727;
    border: 1px solid #313131;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton[preferredChoice="true"] {
    color: #F6F6F6;
    background-color: #656565;
    border-color: #7E7E7E;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton:hover {
    background-color: #2A2A2A;
    border-color: #818181;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton[preferredChoice="true"]:hover {
    background-color: #707070;
    border-color: #999999;
}
QDialog#EldenRingArchiveLayoutDialog QTreeWidget#archivePreviewTree {
    background-color: #232323;
    alternate-background-color: #242424;
    border: 1px solid #2D2D2D;
    border-radius: 6px;
}
QDialog#EldenRingArchiveLayoutDialog QDialogButtonBox#archiveDialogButtons QPushButton {
    min-width: 76px;
    min-height: 30px;
    padding: 5px 12px;
}

/* Audit 2026-10-11: every Settings page uses the same circular heading icons
   (General, Theme and Mod List previously drew them without the circle). */
QDialog#SettingsDialog QWidget#generalTab QLabel#generalPageIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themePageIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListPageIcon {
    background-color: #2A2A2A;
    border: 1px solid #343434;
    border-radius: 18px;
    padding: 0;
}
QDialog#SettingsDialog QWidget#generalTab QLabel#generalLanguageIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalDownloadsIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalUpdatesIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalProfileDefaultsIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalMiscIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalToolbarIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalActionsIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeStyleIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeColorsIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListDisplayIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListWorkflowIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#collapsibleSeparatorsSectionIcon {
    background-color: #2A2A2A;
    border: 1px solid #343434;
    border-radius: 13px;
    padding: 0;
}

/* Settings pages that scroll keep the page surface (was a style sheet in
   settingsdialog.ui, which made every widget on those pages slower to style). */
QDialog#SettingsDialog QScrollArea#generalScrollArea,
QDialog#SettingsDialog QWidget#generalScrollAreaWidgetContents,
QDialog#SettingsDialog QScrollArea#nexusScrollArea,
QDialog#SettingsDialog QWidget#nexusScrollAreaWidgetContents,
QDialog#SettingsDialog QScrollArea#workaroundScrollArea,
QDialog#SettingsDialog QWidget#workaroundScrollAreaWidgetContents {
    background-color: transparent;
}
