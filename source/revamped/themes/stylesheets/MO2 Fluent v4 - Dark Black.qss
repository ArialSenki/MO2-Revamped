/* mo2-base-style: Fusion */
/* MO2 Revamped Fluent v4 Dark Black */

QWidget {
    color: #EDEDED;
    background-color: #242424;
    selection-background-color: #333333;
    selection-color: #EDEDED;
    font-family: "Segoe UI";
    font-size: 9pt;
}

QMainWindow, QDialog, QMessageBox, QInputDialog, QErrorMessage,
QWizard, QWizardPage, QProgressDialog {
    color: #EDEDED;
    background-color: #242424;
}

QLabel, QCheckBox, QRadioButton, QGroupBox, QStatusBar {
    color: #EDEDED;
    background-color: transparent;
}

QAbstractButton {
    color: #EDEDED;
}

/* Keep text and controls readable in MO2 and plugin modal dialogs. */
QDialog QLabel, QMessageBox QLabel, QInputDialog QLabel,
QErrorMessage QLabel, QWizard QLabel, QWizardPage QLabel,
QProgressDialog QLabel {
    color: #EDEDED;
}

QDialogButtonBox {
    background-color: transparent;
}

QDialogButtonBox QPushButton, QMessageBox QPushButton {
    color: #EDEDED;
    background-color: #363636;
    border: 1px solid #454545;
}

QDialogButtonBox QPushButton:disabled, QMessageBox QPushButton:disabled {
    color: #BDBDBD;
    background-color: #303030;
    border-color: #444444;
}

/* Keep check and radio controls visible without relying on external images. */
QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #858585;

    background-color: #2D2D2D;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked {
    border: none;
    background-color: transparent;
    image: url(./mo2-fluent-v4-black/checkbox-checked.svg);
}

QCheckBox::indicator:indeterminate, QGroupBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
    border-color: #E6E6E6;
    background-color: #333333;
}

QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled,
QTreeView::indicator:unchecked:disabled {
    border-color: #555555;
    background-color: #292929;
}

QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled, QGroupBox::indicator:indeterminate:disabled,
QTreeView::indicator:indeterminate:disabled {
    border: none;
    background-color: transparent;
    image: url(./mo2-fluent-v4-black/checkbox-checked-disabled.svg);
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #858585;
    border-radius: 9px;
    background-color: #2D2D2D;
}

QRadioButton::indicator:unchecked {
    border-color: #858585;
    background-color: #2D2D2D;
}

QRadioButton::indicator:checked {
    border: none;
    background-color: transparent;
    image: url(./mo2-fluent-v4-black/radio-checked.svg);
}

QRadioButton::indicator:unchecked:disabled {
    border-color: #555555;
    background-color: #292929;
}

QRadioButton::indicator:checked:disabled {
    border: none;
    background-color: transparent;
    image: url(./mo2-fluent-v4-black/radio-checked-disabled.svg);
}

QWidget:disabled {
    color: #BDBDBD;
}

QMenuBar, QToolBar {
    background-color: #242424;
    border: none;
}

QMenuBar::item {

    padding: 4px 7px;
}

QMenuBar::item:selected {
    background-color: #3C3C3C;
}

QToolBar::separator {
    width: 0px;
    margin: 0px;
    background-color: transparent;
}

QToolButton {
    color: #EDEDED;
    background-color: transparent;
    border: 1px solid transparent;

    padding: 4px 7px;
}

QToolButton:hover, QToolButton:checked, QToolButton:pressed {
    background-color: #3C3C3C;
    border-color: transparent;
}

QPushButton {
    background-color: #363636;
    border: 1px solid #454545;

    padding: 5px 10px;
}

QPushButton:hover {
    background-color: #272727;
    border-color: #BDBDBD;
}

QPushButton:pressed {
    background-color: #3B3B3B;
}

QPushButton:focus, QComboBox:focus, QLineEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QAbstractSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #E6E6E6;
}

QPushButton:disabled {
    color: #BDBDBD;
    background-color: #303030;
    border-color: #444444;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QDateEdit, QTimeEdit, QDateTimeEdit, QPlainTextEdit,
QTextEdit, QAbstractSpinBox {
    color: #EDEDED;
    background-color: #272727;
    border: 1px solid #454545;

    padding: 4px 7px;
}

/* Give numeric controls a clear, full-size stepper instead of the tiny native
   button squares that can disappear against the light background. */
QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    padding-right: 22px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #3C3C3C;
    border-bottom: 1px solid #3C3C3C;
    border-top-right-radius: 2px;
    background-color: #3A3A3A;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #3C3C3C;
    border-bottom-right-radius: 2px;
    background-color: #3A3A3A;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3B3B3B;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(./mo2-fluent-v4-black/spin-up.svg);
    width: 8px;
    height: 6px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(./mo2-fluent-v4-black/spin-down.svg);
    width: 8px;
    height: 6px;
}

QComboBox, QComboBox:hover, QComboBox:on {
    color: #EDEDED;
    background-color: #272727;
    border: 1px solid #454545;
}

QComboBox:focus {
    border: 1px solid #E6E6E6;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

/* Main-window profile selector: a compact label and a clear, rounded field. */
QMainWindow#MainWindow QWidget#centralWidget QLabel#label_3 {
    min-height: 30px;
    max-height: 30px;
    color: #EDEDED;
    background-color: #383838;
    border: 1px solid #4B4B4B;
    border-radius: 7px;
    font-weight: 600;
    padding: 2px 8px;
}
QMainWindow#MainWindow QComboBox#profileBox,
QMainWindow#MainWindow QComboBox#profileBox:hover,
QMainWindow#MainWindow QComboBox#profileBox:on {
    min-height: 30px;
    max-height: 30px;
    padding: 2px 34px 2px 10px;
    color: #EDEDED;
    background-color: #2A2A2A;
    border: 1px solid #4B4B4B;
    border-radius: 8px;
}
QMainWindow#MainWindow QComboBox#profileBox:hover {
    background-color: #323232;
    border-color: #686868;
}
QMainWindow#MainWindow QComboBox#profileBox:focus {
    background-color: #2A2A2A;
    border-color: #E6E6E6;
}
QMainWindow#MainWindow QComboBox#profileBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    border-left: 1px solid #4B4B4B;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: #383838;
}
QMainWindow#MainWindow QComboBox#profileBox::drop-down:hover {
    background-color: #444444;
}
QMainWindow#MainWindow QComboBox#profileBox::down-arrow {
    image: url(./mo2-fluent-v4-black/sort-down-dark.svg);
    width: 10px;
    height: 8px;
}

/* Main-window list options gear and its profile-aware action menu. */
QMainWindow#MainWindow QPushButton#listOptionsBtn {
    min-width: 38px;
    max-width: 38px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px 4px;
    color: #EDEDED;
    background-color: #383838;
    border: 1px solid #535353;
    border-radius: 9px;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:hover {
    color: #EDEDED;
    background-color: #474747;
    border-color: #8F8F8F;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:pressed {
    background-color: #3A3A3A;
    border-color: #8F8F8F;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:focus {
    border-color: #E6E6E6;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn::menu-indicator {
    image: url(./mo2-fluent-v4-black/sort-down-dark.svg);
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 7px;
    height: 6px;
    right: 3px;
}

QMenu#modListOptionsMenu {
    color: #EDEDED;
    background-color: #2A2A2A;
    border: 1px solid #535353;
}
QMenu#modListOptionsMenu::item:selected {
    color: #EDEDED;
    background-color: #464646;
}
QMenu#modListOptionsMenu::item:disabled {
    color: #8F8F8F;
}
QMenu#modListOptionsMenu::separator {
    background-color: #464646;
}

QComboBox QAbstractItemView {
    color: #EDEDED;

    outline: none;

    max-height: 260px;
    selection-background-color: #333333;
    selection-color: #EDEDED;
}

QComboBox QAbstractItemView::item {
    color: #EDEDED;

    min-height: 24px;
    padding: 4px 8px;
    border: none;
}

/* Make the hovered profile option visible before the click. */
QComboBox#profileBox QAbstractItemView::item:hover {
    background-color: #333333;
    color: #EDEDED;
}

QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    background-color: #272727;
    alternate-background-color: #2B2B2B;
    border: 1px solid #3C3C3C;

    gridline-color: #343434;
    outline: none;
    selection-background-color: #333333;
    selection-color: #EDEDED;
}

QTreeView::item, QTreeWidget::item, QListView::item, QListWidget::item,
QTableView::item, QTableWidget::item {
    padding: 3px 6px;
    margin: 0px;
    border: none;
}

/* Keep row content anchored while selection and hover colors change. */
QTreeView#modList::item,
QTreeView#modList::item:hover,
QTreeView#modList::item:selected,
QTreeView#modList::item:focus,
QTreeView#modList::item:selected:focus,
QTreeView#modList::item:hover:selected {
    padding: 2px 8px 2px 10px;
    margin: 0px;
    border: none;
}

/* Inline text editors must fit inside their existing item row. */
QTreeView#modList QLineEdit,
QTreeView#espList QLineEdit,
QTreeView#filetree QLineEdit,
QTreeView#filesView QLineEdit,
QTreeWidget#pluginSettingsList QLineEdit {
    min-height: 16px;
    max-height: 22px;
    padding: 0px 5px;
    margin: 0px;
    border: 1px solid #E6E6E6;
    border-radius: 2px;
}

QTreeView#modList::indicator {
    width: 15px;
    height: 15px;
}

QTreeView#dataTree::item,
QTreeView#dataTree::item:hover,
QTreeView#dataTree::item:selected,
QTreeView#dataTree::item:focus,
QTreeView#dataTree::item:selected:focus,
QTreeView#dataTree::item:hover:selected {
    padding: 4px 8px;
    margin: 0px;
    border: none;
}

/* Keep filter, save, and download rows fixed across hover and selection. */
QTreeWidget#filters::item,
QTreeWidget#filters::item:hover,
QTreeWidget#filters::item:selected,
QTreeWidget#filters::item:focus,
QTreeWidget#filters::item:selected:focus,
QTreeWidget#filters::item:hover:selected {
    padding: 3px 4px;
    margin: 0px;
    border: none;
}

QTreeView#logList {
    alternate-background-color: #2B2B2B;
    selection-background-color: #333333;
    selection-color: #EDEDED;
}

QTreeView#logList::item,
QTreeView#logList::item:hover,
QTreeView#logList::item:selected,
QTreeView#logList::item:focus,
QTreeView#logList::item:selected:focus,
QTreeView#logList::item:hover:selected {
    padding: 2px 6px;
    margin: 0px;
    border: none;
}

QTreeWidget#savegameList::item,
QTreeWidget#savegameList::item:hover,
QTreeWidget#savegameList::item:selected,
QTreeWidget#savegameList::item:focus,
QTreeWidget#savegameList::item:selected:focus,
QTreeWidget#savegameList::item:hover:selected {
    padding: 3px 6px;
    margin: 0px;
    border: none;
}

DownloadListView::item,
DownloadListView::item:hover,
DownloadListView::item:selected,
DownloadListView::item:focus,
DownloadListView::item:selected:focus,
DownloadListView::item:hover:selected {
    margin: 0px;
    border: none;
}

QTableView::item, QTableWidget::item {
    padding: 3px 6px;
}

QTreeView::item:hover:!selected, QTreeWidget::item:hover:!selected,
QListView::item:hover:!selected, QListWidget::item:hover:!selected,
QTableView::item:hover:!selected, QTableWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 5%);
    color: #EDEDED;
}

QAbstractItemView::item:selected, QTreeView::item:selected,
QTreeWidget::item:selected, QListView::item:selected,
QListWidget::item:selected, QTableView::item:selected, QTableWidget::item:selected {
    background-color: transparent;
    color: #EDEDED;
}
/* Keep hover feedback clear while preserving alternating mod-list bands. */
QTreeView#modList::item:hover:!selected {
    background-color: rgba(255, 255, 255, 5%);
}

QHeaderView::section {
    background-color: #2D2D2D;
    border: none;
    border-right: 1px solid #3C3C3C;
    border-bottom: 1px solid #3C3C3C;
    padding: 6px 8px;
    color: #BDBDBD;
    font-weight: 600;
}

/* Give the mod-list sort direction a clear, restrained accent. */
QTreeView#modList QHeaderView::up-arrow {
    image: url(./mo2-fluent-v4-black/sort-up-dark.svg);
    width: 10px;
    height: 8px;
    position: relative;
    right: 10px;
}

QTreeView#modList QHeaderView::down-arrow {
    image: url(./mo2-fluent-v4-black/sort-down-dark.svg);
    width: 10px;
    height: 8px;
    position: relative;
    right: 10px;
}

QTabWidget::pane {
    background-color: #272727;
    border: 1px solid #3C3C3C;

    top: -1px;
}

QTabBar::tab {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    border-bottom: none;

    padding: 6px 12px;
    min-width: 54px;
    min-height: 22px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #363636;
}

QTabBar::tab:selected {
    background-color: #272727;
    color: #EDEDED;
}

QGroupBox {
    border: 1px solid #3C3C3C;

    margin-top: 8px;
    padding: 6px 7px 5px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #BDBDBD;
    background-color: #242424;
}

QMenu {
    background-color: #272727;
    border: 1px solid #454545;

    padding: 5px;
}

QMenu::item {
    background-color: transparent;

    padding: 5px 24px 5px 9px;
}

QMenu::item:selected {
    background-color: #3C3C3C;
    color: #EDEDED;
    border-radius: 4px;
}

QMenu::separator {
    height: 1px;
    background-color: #3A3A3A;
    margin: 3px 6px;
}

QToolTip {
    color: #EDEDED;
    background-color: #323232;
    border: 1px solid #8F8F8F;
    border-radius: 12px;
    padding: 6px 9px;
}

QScrollBar:vertical {
    width: 12px;
    background-color: transparent;
    margin: 1px;
}

QScrollBar:horizontal {
    height: 12px;
    background-color: transparent;
    margin: 1px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #646464;
    border: 2px solid transparent;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #999999;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QSplitter::handle,
QWidget#centralWidget QSplitter#splitter::handle,
QSplitter#categoriesSplitter::handle {
    background-color: #242424;
    border: none;
    image: none;
}

QSplitter::handle:hover, QSplitter::handle:pressed,
QWidget#centralWidget QSplitter#splitter::handle:hover, QWidget#centralWidget QSplitter#splitter::handle:pressed,
QSplitter#categoriesSplitter::handle:hover,
QSplitter#categoriesSplitter::handle:pressed {
    background-color: #242424;
    border: none;
}

QSplitter::handle:horizontal,
QWidget#centralWidget QSplitter#splitter::handle:horizontal,
QSplitter#categoriesSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical,
QWidget#centralWidget QSplitter#splitter::handle:vertical,
QSplitter#categoriesSplitter::handle:vertical {
    height: 4px;
}

QProgressBar {
    background-color: #272727;
    border: 1px solid #454545;

    padding: 1px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #333333;
}

QStatusBar {

    padding: 3px 5px;
}

QDockWidget::title {
    background-color: #2D2D2D;
    padding: 4px 7px;
    border-bottom: 1px solid #3C3C3C;
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    border-radius: 2px;
    background-color: transparent;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #3A3A3A;
}

QGroupBox#categoriesGroup, QWidget#centralWidget QGroupBox#layoutWidget, QGroupBox#layoutWidget_2 {
    background-color: #292929;
}

/* Keep the Filters section label on the dark palette instead of the native
   light title-chip background used by the default Windows style. */
QGroupBox#categoriesGroup {
    color: #EDEDED;

}

QGroupBox#categoriesGroup::title {
    color: #EDEDED;
    background-color: #292929;

    subcontrol-position: top left;

    border: 1px solid #3C3C3C;
    border-radius: 3px;
}

QFrame#startGroup {
    background-color: #2D2D2D;
    border: 1px solid #4B4B4B;

}

QFrame#startGroup QLabel {
    background-color: transparent;
}

QToolButton#startButton,
QToolButton#refinedRunButton {
    background-color: #333333;
    border: 1px solid #E6E6E6;
    border-radius: 8px;
    color: #EDEDED;
    font-weight: 600;
    min-width: 132px;
    min-height: 44px;
    max-height: 44px;
    padding: 2px 0px 2px 12px;
}

QToolButton#startButton:hover,
QToolButton#refinedRunButton:hover {
    background-color: #333333;
    border-color: #BDBDBD;
}

QToolButton#startButton:pressed,
QToolButton#refinedRunButton:pressed {
    background-color: #484848;
}

QToolButton#startButton:disabled,
QToolButton#refinedRunButton:disabled {
    color: #BDBDBD;
    background-color: #363636;
    border-color: #535353;
}

/* A real QToolButton menu subcontrol keeps Run and shortcuts one control. */
QToolButton#startButton::menu-button,
QToolButton#refinedRunButton::menu-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 34px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #8F8F8F;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QToolButton#startButton::menu-arrow,
QToolButton#refinedRunButton::menu-arrow {
    width: 8px;
    height: 8px;
}

/* QLCDNumber paints its digits edge to edge and ignores padding; the border
   lives on the wrapper frame created by LCDNumber::useFrame(). */
QLCDNumber {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QFrame[lcdFrame="true"] {
    background-color: #292929;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
}

/* Accent the main active-mod counter without changing other LCD readouts. */
QLCDNumber#activeModsCounter {
    color: #EDEDED;
}

QFrame#activeModsCounterFrame {
    background-color: #323232;
    border: 1px solid #E6E6E6;
    border-radius: 7px;
}

QComboBox#executablesListBox {
    color: #EDEDED;
    background-color: #2A2A2A;
    border: 1px solid #525252;
    border-radius: 8px;
    min-height: 44px;
    padding: 2px 10px;
}

QComboBox#executablesListBox:hover {
    border-color: #8F8F8F;
}

QComboBox#executablesListBox:focus,
QComboBox#executablesListBox:on {
    border-color: #E6E6E6;
}

QComboBox#executablesListBox QAbstractItemView::item {
    min-height: 28px;
    padding: 5px 10px;
}

QComboBox#executablesListBox QAbstractItemView {
    min-width: 280px;
    max-height: 320px;
}

QComboBox#styleBox {
    min-width: 320px;
}

QTreeWidget#pluginSettingsList::item,
QTreeWidget#pluginSettingsList::item:hover,
QTreeWidget#pluginSettingsList::item:selected,
QTreeWidget#pluginSettingsList::item:focus {
    min-height: 26px;
}

QTreeWidget#pluginSettingsList QComboBox {
    color: #EDEDED;
    background-color: #272727;
    border: 1px solid #454545;
    border-radius: 3px;
    min-height: 22px;
    padding: 1px 5px;
}

QTreeWidget#pluginSettingsList QComboBox:focus,
QTreeWidget#pluginSettingsList QComboBox:on {
    border: 1px solid #E6E6E6;
}

QTreeWidget#pluginSettingsList QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 4px 8px;
}

/* Keep wheel and keyboard scrolling, but remove the idle bar from the mod list. */
#modList QScrollBar:vertical {
    width: 0px;
    margin: 0px;
    border: none;
}

#modList QScrollBar:horizontal {
    height: 0px;
    margin: 0px;
    border: none;
}

/* Keep the model selection for MO2 actions while allowing the application to
   show its highlight only for the view that received the latest click. */
DownloadListView::item:selected {
    background-color: transparent;
    color: #EDEDED;
}

/* Keep the last logical selection readable after focus moves to another
   control, without drawing a full-row focus rectangle. */
QAbstractItemView::item:selected:!active,
QTreeView::item:selected:!active, QTreeWidget::item:selected:!active,
QListView::item:selected:!active, QListWidget::item:selected:!active,
QTableView::item:selected:!active, QTableWidget::item:selected:!active {
    background-color: transparent;
    color: #EDEDED;
    border: none;
}

QTreeView::item:focus, QTreeWidget::item:focus, QListView::item:focus,
QListWidget::item:focus, QTableView::item:focus, QTableWidget::item:focus {
    border: none;
    outline: none;
}

/* MO2 Revamped rounded surfaces, 2026-10-04. */
QGroupBox,
QTabWidget::pane,
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget,
QPlainTextEdit, QTextEdit, QScrollArea, QDockWidget,
QFrame#startGroup {
    border-radius: 8px;
}

QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox,
QDateEdit, QTimeEdit, QDateTimeEdit, QAbstractSpinBox {
    border-radius: 6px;
}

QMenu, QComboBox QFrame {
    border-radius: 8px;
}

QMenuBar::item {
    border-radius: 5px;
}

QMenu::item {
    border-radius: 4px;
}

QTabBar::tab {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QScrollBar::handle, QSplitter::handle {
    border-radius: 5px;
}

QProgressBar {
    border-radius: 6px;
}

QProgressBar::chunk {
    border-radius: 5px;
}

QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator {
    border-radius: 4px;
}

/* MO2 Revamped notification and Overwrite panels. */
QFrame#notificationHeaderPanel, QFrame#notificationListCard,
QFrame#notificationDetailsCard, QFrame#overwriteIntroPanel {
    color: #EDEDED;
    background-color: #2D2D2D;
    border: 1px solid #454545;
    border-radius: 8px;
}

QFrame#notificationHeaderPanel {
    background-color: #373737;
}

QLabel#notificationHeading, QLabel#overwriteHeading {
    color: #EDEDED;
    font-size: 15pt;
    font-weight: 600;
}

QLabel#notificationIntro, QLabel#notificationCountLabel,
QLabel#overwriteDescription {
    color: #BDBDBD;
}

QLabel#notificationListTitle, QLabel#notificationDetailsTitle,
QLabel#overwriteSectionHeading {
    color: #EDEDED;
    font-size: 10pt;
    font-weight: 600;
}

QLabel#selectedTitleLabel {
    color: #EDEDED;
    font-size: 12pt;
    font-weight: 600;
}

QLabel#notificationContextLabel, QLabel#overwriteContextHint {
    color: #EDEDED;
    background-color: #3B3B3B;
    border: 1px solid #4F4F4F;
    border-radius: 6px;
    padding: 9px;
}

QTreeWidget#problemsWidget, QTextBrowser#descriptionText,
QTreeView#filesView {
    color: #EDEDED;
    background-color: #1F1F1F;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 4px;
}

QTreeWidget#problemsWidget::item {
    padding: 6px;
}

QPushButton#manageOverwriteButton, QPushButton#fixButton {
    color: #EDEDED;
    background-color: #333333;
    border: 1px solid #E6E6E6;
    font-weight: 600;
}

QPushButton#manageOverwriteButton:hover, QPushButton#fixButton:hover {
    background-color: #333333;
}

/* Refined filter sidebar and category management dialogs. */
QGroupBox#categoriesGroup {
    background-color: #242424;
    border: 1px solid #454545;
    border-radius: 7px;
    margin-top: 9px;
    padding-top: 7px;
}

QGroupBox#categoriesGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QTreeWidget#filters {
    color: #EDEDED;
    background-color: #272727;
    alternate-background-color: #2D2D2D;
    border: 1px solid #454545;
    border-radius: 5px;
    padding: 2px;
}

QPushButton#filtersClear, QPushButton#filtersEdit,
QComboBox#filtersSeparators {
    min-height: 28px;
}

QDialog#CategoriesDialog QLabel#dialogHeading,
QDialog#CategoryImportDialog QLabel#dialogHeading {
    color: #EDEDED;
    font-size: 12pt;
    font-weight: 600;
}

QDialog#CategoriesDialog QLabel#dialogDescription,
QDialog#CategoriesDialog QLabel#nexusInstructions,
QDialog#CategoriesDialog QLabel#nexusStatus,
QDialog#CategoryImportDialog QLabel#dialogDescription {
    color: #BDBDBD;
