    background-color: #303030;
    border: none;
    border-bottom: 1px solid #454545;
    padding: 6px 8px;
}

QDialog#CategoryImportDialog QRadioButton,
QDialog#CategoryImportDialog QCheckBox {
    min-height: 28px;
}

/* Keep combo-box popups on one rounded surface; the inner viewport must not
   paint a rectangular background over the rounded frame. */
QComboBox QFrame {
    color: #EDEDED;
    background-color: #272727;
    border: 1px solid #454545;
    border-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: transparent;
    border: none;
    border-radius: 7px;
    padding: 3px;
}

QComboBox#languageBox QAbstractItemView {
    padding: 0px 3px;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3D3D3D;
    color: #EDEDED;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #333333;
    color: #EDEDED;
}

