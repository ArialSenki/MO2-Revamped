    border-color: #8F8F8F;
}
QWidget#dataTab QPushButton#dataTabRefresh:pressed {
    background-color: #343434;
}
QWidget#dataTab QTreeView#dataTree {
    color: #EDEDED;
    background-color: #282828;
    alternate-background-color: #2E2E2E;
    border: 1px solid #4B4B4B;
