QDialog#CategoriesDialog QGroupBox#nexusCategoriesCard,
QDialog#CategoryImportDialog QGroupBox#strategyBox,
QDialog#CategoryImportDialog QGroupBox#mappingBox {
    background-color: #282828;
    border: 1px solid #454545;
    border-radius: 7px;
    margin-top: 3px;
    padding: 8px;
}

QDialog#CategoriesDialog QGroupBox#localCategoriesCard::title,
QDialog#CategoriesDialog QGroupBox#nexusCategoriesCard::title,
QDialog#CategoryImportDialog QGroupBox#strategyBox::title,
QDialog#CategoryImportDialog QGroupBox#mappingBox::title {
    subcontrol-origin: margin;
