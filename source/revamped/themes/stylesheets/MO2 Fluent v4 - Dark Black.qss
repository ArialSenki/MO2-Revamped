}

/* Log dock and status strip: keep diagnostic rows readable without a hard selection band. */
QDockWidget#logDock {
    color: #EDEDED;
    background-color: #252525;
    border: 1px solid #4B4B4B;
    border-radius: 8px;
}
QWidget#logDockTitleBar {
    min-height: 34px;
    max-height: 34px;
    background-color: #252525;
    border: none;
    border-bottom: 1px solid #3C3C3C;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QLabel#logDockTitleLabel {
    color: #EDEDED;
    font-weight: 600;
    background-color: transparent;
    border: none;
    padding: 0;
}
QToolButton#logDockCloseButton,
QToolButton#logDockFloatButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #BDBDBD;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 0;
    padding: 0;
}
QToolButton#logDockCloseButton:hover,
QToolButton#logDockFloatButton:hover {
    background-color: transparent;
    border-color: transparent;
}
QToolButton#logDockCloseButton:pressed,
QToolButton#logDockFloatButton:pressed {
    background-color: transparent;
    border-color: transparent;
}
QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: #252525;
    border: none;
}
QDockWidget#logDock QTreeView#logList {
    color: #EDEDED;
    background-color: #252525;
    alternate-background-color: #2B2B2B;
    selection-color: #EDEDED;
    selection-background-color: #464646;
    border: 1px solid #4B4B4B;
    border-radius: 7px;
    outline: none;
    padding: 2px;
}
QDockWidget#logDock QTreeView#logList::item,
QDockWidget#logDock QTreeView#logList::item:hover,
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:focus,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    min-height: 19px;
    padding: 3px 8px;
    margin: 0;
    border: none;
}
QDockWidget#logDock QTreeView#logList::item:hover:!selected {
    background-color: #383838;
}
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    color: #EDEDED;
    background-color: #464646;
}
QStatusBar {
    color: #BDBDBD;
    background-color: #2B2B2B;
    border-top: 1px solid #4B4B4B;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel#apistats {
    margin: 2px 4px;
    padding: 2px 8px;
    border-radius: 5px;
    font-weight: 600;
}
QStatusBar QLabel#apistats[apiState="offline"] {
    color: #BDBDBD;
    background-color: transparent;
    border: none;
}
QStatusBar QLabel#apistats[apiState="healthy"] {
    color: #C3E2CC;
    background-color: #274233;
    border: 1px solid #3C6950;
}
QStatusBar QLabel#apistats[apiState="warning"] {
    color: #F0DDA4;
    background-color: #493F27;
    border: 1px solid #756232;
}
QStatusBar QLabel#apistats[apiState="low"] {
    color: #F2C4C1;
    background-color: #4A3031;
    border: 1px solid #7B4D4A;
}

/* MO2 Revamped Elden Ring archive layout installer. */
QDialog#EldenRingArchiveLayoutDialog {
    color: #EDEDED;
    background-color: #242424;
}
QDialog#EldenRingArchiveLayoutDialog QScrollArea#archiveContentScrollArea,
QDialog#EldenRingArchiveLayoutDialog QWidget#archiveDialogContent {
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveHeaderPanel {
    background-color: #323232;
    border: 1px solid #4B4B4B;
    border-radius: 8px;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveHeaderBadge {
    color: #EDEDED;
    background-color: #535353;
    border: 1px solid #E6E6E6;
    border-radius: 21px;
    font-size: 10pt;
    font-weight: 700;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePageTitle {
    color: #EDEDED;
    background-color: transparent;
    border: none;
    font-size: 14pt;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePageSubtitle,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveSectionDescription,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveFooterNote,
QDialog#EldenRingArchiveLayoutDialog QLabel#archivePreviewNote {
    color: #BDBDBD;
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveNameCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveTextFilesCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archivePackagePathsCard,
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveLayoutChoiceCard {
    color: #EDEDED;
    background-color: #2C2C2C;
    border: 1px solid #494949;
    border-radius: 7px;
}
QDialog#EldenRingArchiveLayoutDialog QFrame#archiveLayoutChoiceCard[preferredChoice="true"] {
    background-color: #363636;
    border: 1px solid #E6E6E6;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveSectionTitle,
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceTitle {
    color: #EDEDED;
    background-color: transparent;
    border: none;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceTitle {
    font-size: 11pt;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveLayoutChoiceDescription {
    color: #BDBDBD;
    background-color: transparent;
    border: none;
}
QDialog#EldenRingArchiveLayoutDialog QLabel#archiveFieldLabel {
    color: #EDEDED;
    background-color: transparent;
    border: none;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QLineEdit#archiveModNameEdit {
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #505050;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 22px;
}
QDialog#EldenRingArchiveLayoutDialog QLineEdit#archiveModNameEdit:focus {
    border-color: #E6E6E6;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton {
    color: #EDEDED;
    background-color: #2E2E2E;
    border: 1px solid #505050;
    border-radius: 6px;
    padding: 6px 12px;
    text-align: left;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton:hover {
    background-color: #373737;
    border-color: #676767;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archivePreviewButton:checked {
    background-color: #3A3A3A;
    border-color: #E6E6E6;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton {
    color: #EDEDED;
    background-color: #373737;
    border: 1px solid #575757;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton[preferredChoice="true"] {
    color: #EDEDED;
    background-color: #333333;
    border-color: #E6E6E6;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton:hover {
    background-color: #464646;
    border-color: #8F8F8F;
}
QDialog#EldenRingArchiveLayoutDialog QPushButton#archiveLayoutChoiceButton[preferredChoice="true"]:hover {
    background-color: #333333;
    border-color: #E6E6E6;
}
QDialog#EldenRingArchiveLayoutDialog QTreeWidget#archivePreviewTree {
    background-color: #232323;
    alternate-background-color: #2C2C2C;
    border: 1px solid #494949;
    border-radius: 6px;
}
QDialog#EldenRingArchiveLayoutDialog QDialogButtonBox#archiveDialogButtons QPushButton {
    min-width: 76px;
    min-height: 30px;
    padding: 5px 12px;
}

/* Audit 2026-10-11: every Settings page uses the same circular heading icons
   (General, Theme and Mod List previously drew them without the circle). */
QDialog#SettingsDialog QWidget#generalTab QLabel#generalPageIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themePageIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListPageIcon {
    background-color: #454545;
    border: 1px solid #646464;
    border-radius: 18px;
    padding: 0;
}
QDialog#SettingsDialog QWidget#generalTab QLabel#generalLanguageIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalDownloadsIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalUpdatesIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalProfileDefaultsIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalMiscIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalToolbarIcon,
QDialog#SettingsDialog QWidget#generalTab QLabel#generalActionsIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeStyleIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeColorsIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListDisplayIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListWorkflowIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#collapsibleSeparatorsSectionIcon {
    background-color: #454545;
    border: 1px solid #646464;
    border-radius: 13px;
    padding: 0;
}

/* ======================================================================
   MO2 Fluent v4: Windows 11 style layer.
   Generated by Build-FluentTheme.ps1 from this template; @name@ tokens are
   replaced per theme. Rules repeat the selectors of the base theme so they
   win by order without raising specificity.
   ====================================================================== */

QWidget {
    font-family: "Segoe UI Variable Text", "Segoe UI";
    selection-background-color: #383838;
    selection-color: #EDEDED;
}

QMainWindow, QDialog, QMessageBox,
QMainWindow#MainWindow QWidget#centralWidget {
    background-color: #181818;
}

QWidget:disabled {
    color: #8F8F8F;
}

/* Command bar: flat buttons on the window surface, a hairline below. */
QMenuBar {
    color: #EDEDED;
    background-color: #181818;
    border: none;
    padding: 2px 4px;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background-color: transparent;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #262626;
}

QToolBar, QMainWindow#MainWindow QToolBar#toolBar {
    background-color: #181818;
    border: none;
    border-bottom: 1px solid #2C2C2C;
    padding: 4px 8px 4px 8px;
    spacing: 4px;
}
QToolBar > QWidget,
QMainWindow#MainWindow QToolBar#toolBar > QWidget {
    background-color: transparent;
}
QToolButton {
    color: #EDEDED;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: #262626;
    border-color: transparent;
}
QToolButton:pressed, QToolButton:checked {
    color: #BDBDBD;
    background-color: #1F1F1F;
    border-color: transparent;
}
/* Command bar: 16px glyphs, compact 32px buttons like File Explorer's. */
QMainWindow#MainWindow QToolBar#toolBar QToolButton {
    margin: 0px 1px;
    padding: 6px 8px;
}
QToolButton::menu-indicator {
    image: url(./mo2-fluent-v4-black/chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
    right: 3px;
    bottom: 3px;
}

/* Menus: one rounded flyout, compact rows, no descriptions. */
QMenu,
QMenu#modListOptionsMenu,
QMenu#openFolderMenuPopup {
    color: #EDEDED;
    background-color: #232323;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item,
QMenu#modListOptionsMenu::item,
QMenu#openFolderMenuPopup::item {
    min-height: 22px;
    padding: 5px 28px 5px 10px;
    margin: 1px 0px;
    border-radius: 4px;
    background-color: transparent;
}
QMenu::item:selected,
QMenu#modListOptionsMenu::item:selected,
QMenu#openFolderMenuPopup::item:selected {
    color: #EDEDED;
    background-color: #262626;
}
QMenu::item:disabled,
QMenu#modListOptionsMenu::item:disabled,
QMenu#openFolderMenuPopup::item:disabled {
    color: #8F8F8F;
}
QMenu::separator,
QMenu#modListOptionsMenu::separator,
QMenu#openFolderMenuPopup::separator {
    height: 1px;
    margin: 4px 0px;
    background-color: #2C2C2C;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::right-arrow {
    image: url(./mo2-fluent-v4-black/chevron-right.svg);
    width: 10px;
    height: 10px;
}

QToolTip {
    color: #EDEDED;
    background-color: #232323;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 5px 8px;
}

/* Buttons: standard Fluent button with a slightly darker lower edge. */
QPushButton {
    color: #EDEDED;
    background-color: #252525;
    border: 1px solid #353535;
    border-bottom-color: #3E3E3E;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background-color: #2B2B2B;
}
QPushButton:pressed {
    color: #BDBDBD;
    background-color: #1F1F1F;
    border-bottom-color: #353535;
}
QPushButton:disabled {
    color: #8F8F8F;
    background-color: #212121;
    border-color: #2C2C2C;
}
QPushButton:default {
    color: #000000;
    background-color: #D6D6D6;
    border: 1px solid #D6D6D6;
}
QPushButton:default:hover {
    background-color: #C6C6C6;
    border-color: #C6C6C6;
}
QPushButton:default:pressed {
    background-color: #B3B3B3;
    border-color: #B3B3B3;
}

/* Text fields: flat field, accent bottom edge when focused. */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QDateEdit, QTimeEdit, QDateTimeEdit, QPlainTextEdit,
QTextEdit, QAbstractSpinBox {
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
    border-radius: 4px;
    padding: 4px 8px;
}
QComboBox, QComboBox:hover, QComboBox:on {
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover {
    background-color: #2B2B2B;
}
QPushButton:focus {
    border: 1px solid #353535;
    border-bottom-color: #3E3E3E;
}
QComboBox:focus, QLineEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QAbstractSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 2px solid #D6D6D6;
    padding-bottom: 3px;
}
QComboBox::drop-down {
    width: 28px;
    border: none;
    background-color: transparent;
}
QComboBox::down-arrow {
    image: url(./mo2-fluent-v4-black/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QComboBox QFrame {
    color: #EDEDED;
    background-color: #232323;
    border: 1px solid #333333;
    border-radius: 8px;
}
QComboBox QAbstractItemView {
    color: #EDEDED;
    background-color: transparent;
    border: none;
    padding: 4px;
    selection-background-color: #262626;
    selection-color: #EDEDED;
}
QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 3px 10px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover,
QComboBox#profileBox QAbstractItemView::item:hover {
    color: #EDEDED;
    background-color: #262626;
}
QComboBox QAbstractItemView::item:selected {
    color: #EDEDED;
    background-color: #383838;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #262626;
}

/* Check boxes, radio buttons, and switches. */
QCheckBox::indicator, QGroupBox::indicator, QTreeView::indicator {
    width: 18px;
    height: 18px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
}
QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked,
QTreeView::indicator:unchecked {
    image: url(./mo2-fluent-v4-black/checkbox-unchecked.svg);
}
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover,
QTreeView::indicator:unchecked:hover {
    image: url(./mo2-fluent-v4-black/checkbox-unchecked-hover.svg);
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked {
    image: url(./mo2-fluent-v4-black/checkbox-checked.svg);
}
QCheckBox::indicator:indeterminate, QGroupBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
    image: url(./mo2-fluent-v4-black/checkbox-indeterminate.svg);
}
QCheckBox::indicator:unchecked:disabled, QGroupBox::indicator:unchecked:disabled,
QTreeView::indicator:unchecked:disabled {
    image: url(./mo2-fluent-v4-black/checkbox-disabled.svg);
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled, QGroupBox::indicator:indeterminate:disabled,
QTreeView::indicator:indeterminate:disabled {
    image: url(./mo2-fluent-v4-black/checkbox-checked-disabled.svg);
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}
QRadioButton::indicator:unchecked {
    image: url(./mo2-fluent-v4-black/radio-unchecked.svg);
}
QRadioButton::indicator:unchecked:hover {
    image: url(./mo2-fluent-v4-black/radio-unchecked-hover.svg);
}
QRadioButton::indicator:checked {
    image: url(./mo2-fluent-v4-black/radio-checked.svg);
}
QRadioButton::indicator:unchecked:disabled {
    image: url(./mo2-fluent-v4-black/radio-disabled.svg);
}
QRadioButton::indicator:checked:disabled {
    image: url(./mo2-fluent-v4-black/radio-checked-disabled.svg);
}

/* Lists, trees, and headers. */
QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget {
    color: #EDEDED;
    background-color: #222222;
    alternate-background-color: #252525;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    gridline-color: #2C2C2C;
    selection-background-color: #383838;
    selection-color: #EDEDED;
}
QTreeView::item:hover:!selected, QTreeWidget::item:hover:!selected,
QListView::item:hover:!selected, QListWidget::item:hover:!selected,
QTableView::item:hover:!selected, QTableWidget::item:hover:!selected {
    color: #EDEDED;
    background-color: #2A2A2A;
}
QHeaderView::section {
    color: #BDBDBD;
    background-color: #222222;
    border: none;
    border-right: 1px solid #2C2C2C;
    border-bottom: 1px solid #2C2C2C;
    padding: 6px 9px;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: #2A2A2A;
}

QScrollBar:vertical {
    width: 10px;
    background-color: transparent;
    margin: 2px;
}
QScrollBar:horizontal {
    height: 10px;
    background-color: transparent;
    margin: 2px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #4E4E4E;
    border: none;
    border-radius: 3px;
    min-height: 28px;
    min-width: 28px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #7A7A7A;
}

QSplitter::handle,
QWidget#centralWidget QSplitter#splitter::handle,
QSplitter#categoriesSplitter::handle,
QSplitter::handle:hover, QSplitter::handle:pressed,
QWidget#centralWidget QSplitter#splitter::handle:hover,
QWidget#centralWidget QSplitter#splitter::handle:pressed,
QSplitter#categoriesSplitter::handle:hover,
QSplitter#categoriesSplitter::handle:pressed {
    background-color: #181818;
    border: none;
    image: none;
}
QWidget#centralWidget QSplitter#splitter::handle:horizontal {
    width: 10px;
}

QProgressBar {
    color: #EDEDED;
    background-color: #2C2C2C;
    border: none;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #D6D6D6;
    border-radius: 4px;
}

QGroupBox::title {
    color: #BDBDBD;
    background-color: transparent;
}

/* Main window: profile row. */
QMainWindow#MainWindow QWidget#centralWidget QLabel#label_3 {
    min-height: 32px;
    max-height: 32px;
    color: #BDBDBD;
    background-color: transparent;
    border: none;
    font-weight: 600;
    padding: 0px 2px 0px 4px;
}
QMainWindow#MainWindow QComboBox#profileBox,
QMainWindow#MainWindow QComboBox#profileBox:hover,
QMainWindow#MainWindow QComboBox#profileBox:on {
    min-height: 30px;
    max-height: 30px;
    padding: 0px 30px 0px 10px;
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
    border-radius: 4px;
}
QMainWindow#MainWindow QComboBox#profileBox:hover {
    background-color: #2B2B2B;
    border-color: #353535;
    border-bottom-color: #8F8F8F;
}
QMainWindow#MainWindow QComboBox#profileBox:focus {
    background-color: #262626;
    border-color: #353535;
    border-bottom: 2px solid #D6D6D6;
}
QMainWindow#MainWindow QComboBox#profileBox::drop-down,
QMainWindow#MainWindow QComboBox#profileBox::drop-down:hover {
    width: 28px;
    border: none;
    background-color: transparent;
}
QMainWindow#MainWindow QComboBox#profileBox::down-arrow {
    image: url(./mo2-fluent-v4-black/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn,
QMainWindow#MainWindow QPushButton#openFolderMenu {
    min-width: 34px;
    max-width: 34px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px;
    color: #EDEDED;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:hover,
QMainWindow#MainWindow QPushButton#openFolderMenu:hover {
    background-color: #262626;
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:pressed,
QMainWindow#MainWindow QPushButton#openFolderMenu:pressed {
    background-color: #1F1F1F;
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn:focus,
QMainWindow#MainWindow QPushButton#openFolderMenu:focus {
    border-color: transparent;
}
QMainWindow#MainWindow QPushButton#listOptionsBtn::menu-indicator,
QMainWindow#MainWindow QPushButton#openFolderMenu::menu-indicator {
    image: none;
    width: 0px;
}

QLCDNumber#activeModsCounter {
    color: #E6E6E6;
}
QFrame[lcdFrame="true"] {
    background-color: #262626;
    border: 1px solid #353535;
    border-radius: 4px;
}
QFrame#activeModsCounterFrame {
    min-height: 30px;
    max-height: 30px;
    background-color: #333333;
    border: 1px solid #333333;
    border-radius: 4px;
}

/* Main window: mod list card. Enabled state uses Fluent switches. */
QMainWindow#MainWindow QTreeView#modList {
    color: #EDEDED;
    background-color: #222222;
    alternate-background-color: #252525;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    gridline-color: #2C2C2C;
    selection-background-color: #383838;
    selection-color: #EDEDED;
}
QMainWindow#MainWindow QTreeView#modList:focus {
    border-color: #2E2E2E;
}
QMainWindow#MainWindow QTreeView#modList::item:hover:!selected {
    background-color: #2A2A2A;
}
QMainWindow#MainWindow QTreeView#modList::item:selected,
QMainWindow#MainWindow QTreeView#modList::item:selected:focus,
QMainWindow#MainWindow QTreeView#modList::item:hover:selected {
    color: #EDEDED;
    background-color: #383838;
}
QMainWindow#MainWindow QTreeView#modList::item:selected:first,
QMainWindow#MainWindow QTreeView#modList::item:selected:focus:first,
QMainWindow#MainWindow QTreeView#modList::item:hover:selected:first {
    border-left: 3px solid #D6D6D6;
    padding-left: 7px;
}
QMainWindow#MainWindow QTreeView#modList QHeaderView::section {
    min-height: 28px;
    padding: 6px 9px;
    color: #BDBDBD;
    background-color: #222222;
    border: none;
    border-bottom: 1px solid #2C2C2C;
    font-weight: 600;
}
QMainWindow#MainWindow QTreeView#modList QHeaderView::section:hover {
    background-color: #2A2A2A;
}
QTreeView#modList QHeaderView::up-arrow {
    image: url(./mo2-fluent-v4-black/sort-up.svg);
}
QTreeView#modList QHeaderView::down-arrow {
    image: url(./mo2-fluent-v4-black/sort-down.svg);
}
QTreeView#modList::indicator {
    width: 36px;
    height: 18px;
}
QTreeView#modList::indicator:unchecked {
    image: url(./mo2-fluent-v4-black/switch-off.svg);
}
QTreeView#modList::indicator:unchecked:hover {
    image: url(./mo2-fluent-v4-black/switch-off-hover.svg);
}
QTreeView#modList::indicator:checked,
QTreeView#modList::indicator:indeterminate {
    image: url(./mo2-fluent-v4-black/switch-on.svg);
}
QTreeView#modList::indicator:checked:hover {
    image: url(./mo2-fluent-v4-black/switch-on-hover.svg);
}
QTreeView#modList::indicator:unchecked:disabled {
    image: url(./mo2-fluent-v4-black/switch-off-disabled.svg);
}
QTreeView#modList::indicator:checked:disabled,
QTreeView#modList::indicator:indeterminate:disabled {
    image: url(./mo2-fluent-v4-black/switch-on-disabled.svg);
}

/* Main window: mod list footer. */
QMainWindow#MainWindow QPushButton#displayCategoriesBtn,
QMainWindow#MainWindow QPushButton#clearFiltersButton {
    min-height: 30px;
    color: #EDEDED;
    background-color: #252525;
    border: 1px solid #353535;
    border-bottom-color: #3E3E3E;
    border-radius: 4px;
}
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:hover,
QMainWindow#MainWindow QPushButton#clearFiltersButton:hover {
    background-color: #2B2B2B;
    border-color: #353535;
    border-bottom-color: #3E3E3E;
}
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:checked,
QMainWindow#MainWindow QPushButton#displayCategoriesBtn:pressed {
    color: #000000;
    background-color: #D6D6D6;
    border-color: #D6D6D6;
}
QMainWindow#MainWindow QWidget#centralWidget QLabel#label_2,
QMainWindow#MainWindow QLabel#currentCategoryLabel {
    color: #BDBDBD;
}
QMainWindow#MainWindow QComboBox#groupCombo,
QMainWindow#MainWindow QLineEdit#modFilterEdit {
    min-height: 30px;
    max-height: 32px;
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
    border-radius: 4px;
}
QMainWindow#MainWindow QComboBox#groupCombo:hover {
    background-color: #2B2B2B;
    border-color: #353535;
    border-bottom-color: #8F8F8F;
}
QMainWindow#MainWindow QComboBox#groupCombo:focus,
QMainWindow#MainWindow QLineEdit#modFilterEdit:focus {
    border-color: #353535;
    border-bottom: 2px solid #D6D6D6;
}
QMainWindow#MainWindow QComboBox#groupCombo::drop-down,
QMainWindow#MainWindow QComboBox#groupCombo::drop-down:hover {
    width: 28px;
    border: none;
    background-color: transparent;
}
QMainWindow#MainWindow QComboBox#groupCombo::down-arrow {
    image: url(./mo2-fluent-v4-black/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* Main window: executable picker and the accent Run button. */
QFrame#startGroup {
    background-color: transparent;
    border: none;
}
QComboBox#executablesListBox {
    min-height: 30px;
    max-height: 30px;
    padding: 0px 10px;
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
    border-radius: 4px;
}
QComboBox#executablesListBox:hover {
    background-color: #2B2B2B;
    border-color: #353535;
    border-bottom-color: #8F8F8F;
}
QComboBox#executablesListBox:focus,
QComboBox#executablesListBox:on {
    border-color: #353535;
    border-bottom: 2px solid #D6D6D6;
}
QToolButton#startButton,
QToolButton#refinedRunButton {
    min-width: 124px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px 0px 0px 12px;
    color: #000000;
    background-color: #D6D6D6;
    border: 1px solid #D6D6D6;
    border-radius: 4px;
    font-weight: 600;
}
QToolButton#startButton:hover,
QToolButton#refinedRunButton:hover {
    background-color: #C6C6C6;
    border-color: #C6C6C6;
}
QToolButton#startButton:pressed,
QToolButton#refinedRunButton:pressed {
    color: #2A2A2A;
    background-color: #B3B3B3;
    border-color: #B3B3B3;
}
QToolButton#startButton:disabled,
QToolButton#refinedRunButton:disabled {
    color: #8F8F8F;
    background-color: #212121;
    border-color: #2C2C2C;
}
QToolButton#startButton::menu-button,
QToolButton#refinedRunButton::menu-button {
    width: 30px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #6A6A6A;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QToolButton#startButton::menu-arrow,
QToolButton#refinedRunButton::menu-arrow {
    image: url(./mo2-fluent-v4-black/chevron-down-accent.svg);
    width: 10px;
    height: 10px;
}

/* Main window: Data, Saves, and Downloads card with underline tabs. */
QTabWidget::pane,
QWidget#centralWidget QTabWidget#tabWidget::pane,
QDialog#SettingsDialog QTabWidget#tabWidget::pane,
QDialog#ModInfoDialog QTabWidget#tabWidget::pane {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 6px;
}
QTabBar,
QWidget#centralWidget QTabWidget#tabWidget QTabBar {
    background-color: transparent;
}
QTabBar::tab,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab {
    color: #BDBDBD;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    min-width: 40px;
    min-height: 22px;
    padding: 7px 12px 5px 12px;
    margin: 0px 2px 0px 0px;
}
QTabBar::tab:hover,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab:hover,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab:hover,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab:hover {
    color: #EDEDED;
    background-color: transparent;
    border-bottom-color: #2C2C2C;
}
QTabBar::tab:selected,
QWidget#centralWidget QTabWidget#tabWidget QTabBar::tab:selected,
QDialog#SettingsDialog QTabWidget#tabWidget QTabBar::tab:selected,
QDialog#ModInfoDialog QTabWidget#tabWidget QTabBar::tab:selected {
    color: #EDEDED;
    background-color: transparent;
    border-bottom: 3px solid #D6D6D6;
}

QWidget#dataTab QTreeView#dataTree,
QWidget#savesTab QTreeWidget#savegameList,
QWidget#downloadTab DownloadListView#downloadView,
QWidget#espTab PluginListView#espList,
QWidget#centralWidget QTabWidget#tabWidget QTreeView,
QWidget#centralWidget QTabWidget#tabWidget QTreeWidget {
    color: #EDEDED;
    background-color: #222222;
    alternate-background-color: #252525;
    border: none;
    border-radius: 0px;
    gridline-color: #2C2C2C;
    selection-background-color: #383838;
    selection-color: #EDEDED;
}
QWidget#savesTab QTreeWidget#savegameList:focus,
QWidget#downloadTab DownloadListView#downloadView:focus {
    border: none;
}
QWidget#dataTab QTreeView#dataTree::item:hover {
    background-color: #2A2A2A;
}
QWidget#dataTab QTreeView#dataTree::item:selected,
QWidget#dataTab QTreeView#dataTree::item:selected:focus,
QWidget#dataTab QTreeView#dataTree::item:hover:selected {
    color: #EDEDED;
    background-color: #383838;
}
QWidget#dataTab QTreeView#dataTree QHeaderView::section,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::section,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::section {
    min-height: 28px;
    padding: 6px 9px;
    color: #BDBDBD;
    background-color: #222222;
    border: none;
    border-right: 1px solid #2C2C2C;
    border-bottom: 1px solid #2C2C2C;
    font-weight: 600;
}
QWidget#dataTab QTreeView#dataTree QHeaderView::section:hover,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::section:hover,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::section:hover {
    background-color: #2A2A2A;
}
QHeaderView::up-arrow,
QWidget#dataTab QTreeView#dataTree QHeaderView::up-arrow,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::up-arrow,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::up-arrow {
    image: url(./mo2-fluent-v4-black/sort-up.svg);
}
QHeaderView::down-arrow,
QWidget#dataTab QTreeView#dataTree QHeaderView::down-arrow,
QWidget#savesTab QTreeWidget#savegameList QHeaderView::down-arrow,
QWidget#downloadTab DownloadListView#downloadView QHeaderView::down-arrow {
    image: url(./mo2-fluent-v4-black/sort-down.svg);
}

QWidget#dataTab QPushButton#dataTabRefresh,
QWidget#downloadTab QPushButton#btnRefreshDownloads,
QWidget#espTab QPushButton#sortButton {
    min-height: 30px;
    padding: 4px 12px;
    color: #EDEDED;
    background-color: #252525;
    border: 1px solid #353535;
    border-bottom-color: #3E3E3E;
    border-radius: 4px;
    font-weight: 400;
}
QWidget#dataTab QPushButton#dataTabRefresh:hover,
QWidget#downloadTab QPushButton#btnRefreshDownloads:hover,
QWidget#espTab QPushButton#sortButton:hover {
    color: #EDEDED;
    background-color: #2B2B2B;
    border-color: #353535;
    border-bottom-color: #3E3E3E;
}
QWidget#dataTab QPushButton#dataTabRefresh:pressed,
QWidget#downloadTab QPushButton#btnRefreshDownloads:pressed,
QWidget#espTab QPushButton#sortButton:pressed {
    color: #BDBDBD;
    background-color: #1F1F1F;
}

/* Toggles in the tab footers render as Fluent switches. */
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts,
QWidget#dataTab QCheckBox#dataTabShowFromArchives,
QWidget#downloadTab QCheckBox#showHiddenBox,
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives:hover,
QWidget#downloadTab QCheckBox#showHiddenBox:hover,
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts:checked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives:checked,
QWidget#downloadTab QCheckBox#showHiddenBox:checked {
    min-height: 30px;
    padding: 3px 6px;
    spacing: 8px;
    color: #EDEDED;
    background-color: transparent;
    border: none;
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator {
    width: 40px;
    height: 20px;
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:unchecked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:unchecked,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:unchecked {
    image: url(./mo2-fluent-v4-black/switch-off.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:unchecked:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:unchecked:hover,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:unchecked:hover {
    image: url(./mo2-fluent-v4-black/switch-off-hover.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:checked,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:checked,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:checked {
    image: url(./mo2-fluent-v4-black/switch-on.svg);
}
QWidget#dataTab QCheckBox#dataTabShowOnlyConflicts::indicator:checked:hover,
QWidget#dataTab QCheckBox#dataTabShowFromArchives::indicator:checked:hover,
QWidget#downloadTab QCheckBox#showHiddenBox::indicator:checked:hover {
    image: url(./mo2-fluent-v4-black/switch-on-hover.svg);
}
QWidget#dataTab QLineEdit#dataTabFilter,
QWidget#downloadTab QLineEdit#downloadFilterEdit {
    min-height: 30px;
    padding: 4px 10px;
    color: #EDEDED;
    background-color: #262626;
    border: 1px solid #353535;
    border-bottom: 1px solid #8F8F8F;
    border-radius: 4px;
}
QWidget#dataTab QLineEdit#dataTabFilter:focus,
QWidget#downloadTab QLineEdit#downloadFilterEdit:focus {
    border-color: #353535;
    border-bottom: 2px solid #D6D6D6;
}

/* Log and status bar. */
QDockWidget#logDock {
    color: #EDEDED;
    background-color: #181818;
    border: none;
}
QWidget#logDockTitleBar {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-bottom: 1px solid #2C2C2C;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QLabel#logDockTitleLabel {
    color: #EDEDED;
}
QToolButton#logDockCloseButton,
QToolButton#logDockFloatButton {
    color: #BDBDBD;
    border-radius: 4px;
}
QToolButton#logDockCloseButton:hover,
QToolButton#logDockFloatButton:hover {
    background-color: #262626;
}
QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: #181818;
}
QDockWidget#logDock QTreeView#logList {
    color: #EDEDED;
    background-color: #222222;
    alternate-background-color: #252525;
    selection-color: #EDEDED;
    selection-background-color: #383838;
    border: 1px solid #2E2E2E;
    border-top: none;
    border-radius: 0px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QDockWidget#logDock QTreeView#logList::item:hover:!selected {
    background-color: #2A2A2A;
}
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    color: #EDEDED;
    background-color: #383838;
}

QStatusBar {
    color: #BDBDBD;
    background-color: #181818;
    border-top: 1px solid #2C2C2C;
}
QStatusBar QLabel#apistats {
    border-radius: 4px;
}
QStatusBar QLabel#apistats[apiState="warning"] {
    color: #F5D58C;
    background-color: #3D3218;
    border: 1px solid #3D3218;
}

/* ----------------------------------------------------------------------
   Fluent v4 main window structure (cards, Run row, expander). These
   object names exist only in the Fluent build of mainwindow.ui; older
   builds ignore the rules.
   ---------------------------------------------------------------------- */

/* Run row at the top of the Data card, the same height as the profile row
   of the mod list card so both cards line up. */
QFrame[fluentCard="true"] QFrame#startGroup {
    background-color: transparent;
    border: none;
}

QFrame[fluentCard="true"] {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QFrame[fluentCard="true"] QLabel {
    background-color: transparent;
}
QMainWindow#MainWindow QFrame[fluentCard="true"] QTreeView#modList {
    background-color: #222222;
    border: none;
    border-top: 1px solid #2C2C2C;
    border-bottom: 1px solid #2C2C2C;
    border-radius: 0px;
}
QFrame[fluentCard="true"] QTabWidget::pane,
QWidget#centralWidget QFrame[fluentCard="true"] QTabWidget#tabWidget::pane {
    background-color: #222222;
    border: none;
    border-top: 1px solid #2C2C2C;
    border-radius: 0px;
    top: 0px;
}
QFrame[fluentCard="true"] QTabWidget::tab-bar {
    left: 0px;
}

FluentTabBar {
    qproperty-indicatorColor: #D6D6D6;
    background-color: transparent;
}
FluentTabBar::tab,
FluentTabBar::tab:hover,
FluentTabBar::tab:selected {
    border-bottom: 3px solid transparent;
}
FluentTabBar::tab:hover:!selected {
    color: #EDEDED;
}

/* Glyph buttons: the icon font has to come from here, since the QWidget rule
   above overrides fonts set in code; in the text font Qt searches every
   installed font for the glyph and logs DirectWrite errors on the old ones. */
QMainWindow#MainWindow QToolButton#moreActionsBtn {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 15px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
    color: #EDEDED;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn:hover {
    background-color: #262626;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn:pressed,
QMainWindow#MainWindow QToolButton#moreActionsBtn:open {
    background-color: #1F1F1F;
}
QMainWindow#MainWindow QToolButton#moreActionsBtn::menu-indicator {
    image: none;
    width: 0px;
}
QMainWindow#MainWindow QLabel#activeModslabel {
    color: #BDBDBD;
    padding-left: 6px;
}

/* Run button states: Mounting and Starting keep the accent, Running turns green. */
QToolButton#startButton[runState="busy"],
QToolButton#startButton[runState="busy"]:disabled {
    color: #000000;
    background-color: #B3B3B3;
    border-color: #B3B3B3;
}
QToolButton#startButton[runState="running"],
QToolButton#startButton[runState="running"]:disabled {
    color: #000000;
    background-color: #6CCB5F;
    border-color: #6CCB5F;
}

/* Log expander row. */
QWidget#logDockTitleBar {
    min-height: 34px;
    max-height: 34px;
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QDockWidget#logDock QWidget#logDockTitleBar {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
QLabel#logDockSummaryLabel {
    color: #BDBDBD;
    background-color: transparent;
    padding-left: 6px;
}
QToolButton#logDockExpandButton {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 8pt;
    color: #BDBDBD;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QToolButton#logDockExpandButton:hover {
    color: #EDEDED;
    background-color: #262626;
}

/* The animated pill replaces the stylesheet underline in the main window. */
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab,
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab:hover,
QWidget#centralWidget QTabWidget#tabWidget FluentTabBar::tab:selected {
    border-bottom: 3px solid transparent;
}

/* Animated mod list switches (ModListView paints them with these colors). */
QMainWindow#MainWindow ModListView#modList {
    qproperty-switchOnColor: #D6D6D6;
    qproperty-switchOffColor: #262626;
    qproperty-switchBorderColor: #8F8F8F;
    qproperty-switchKnobOnColor: #000000;
    qproperty-switchKnobOffColor: #BDBDBD;
}

/* Card interiors: the tab widget, its pages, and the stacked widget between
   them are transparent so the card surface shows through. */
QFrame[fluentCard="true"] QTabWidget,
QFrame[fluentCard="true"] QStackedWidget,
QWidget#centralWidget QTabWidget#tabWidget QStackedWidget > QWidget {
    background-color: transparent;
}

/* Command bar menus: the chevron sits on the text line at the right edge. */
QMainWindow#MainWindow QToolBar#toolBar QToolButton[popupMode="2"] {
    padding-right: 18px;
}
/* the overflow button is "...": no chevron next to it */
QMainWindow#MainWindow QToolBar#toolBar QToolButton#actionFluentMore,
QMainWindow#MainWindow QToolBar#toolBar QToolButton[popupMode="2"]#actionFluentMore {
    padding-right: 8px;
}
QMainWindow#MainWindow QToolBar#toolBar QToolButton#actionFluentMore::menu-indicator {
    image: none;
    width: 0px;
}
QMainWindow#MainWindow QToolBar#toolBar QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    bottom: 0px;
}

/* Footer rows and tab toolbars share the 32px line of the top rows: no
   vertical padding plus a 1px border. A focused field draws a 2px accent edge,
   so its content shrinks by 1px to keep the same outer height. */
QMainWindow#MainWindow QPushButton#displayCategoriesBtn,
QMainWindow#MainWindow QPushButton#clearFiltersButton,
QMainWindow#MainWindow QComboBox#groupCombo,
QMainWindow#MainWindow QLineEdit#modFilterEdit,
QWidget#dataTab QLineEdit#dataTabFilter,
QWidget#downloadTab QLineEdit#downloadFilterEdit,
QWidget#dataTab QPushButton#dataTabRefresh,
QWidget#downloadTab QPushButton#btnRefreshDownloads,
QWidget#espTab QPushButton#sortButton {
    min-height: 30px;
    max-height: 30px;
    padding-top: 0px;
    padding-bottom: 0px;
}
QMainWindow#MainWindow QComboBox#groupCombo:focus,
QMainWindow#MainWindow QLineEdit#modFilterEdit:focus,
QWidget#dataTab QLineEdit#dataTabFilter:focus,
QWidget#downloadTab QLineEdit#downloadFilterEdit:focus,
QMainWindow#MainWindow QComboBox#profileBox:focus,
QComboBox#executablesListBox:focus,
QComboBox#executablesListBox:on {
    min-height: 29px;
    max-height: 29px;
    padding-top: 0px;
    padding-bottom: 0px;
}

/* Mica: on Windows 11 the main window is translucent and MOApplication sets
   fluentMica, so the window surfaces between the cards let the system
   backdrop through. The cards, lists and fields keep their own fill. */
QMainWindow#MainWindow[fluentMica="true"],
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#categoriesSplitter,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle:hover,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitter#splitter::handle:pressed,
QMainWindow#MainWindow[fluentMica="true"] QWidget#centralWidget QSplitterHandle,
QMainWindow#MainWindow[fluentMica="true"]::separator,
QMainWindow#MainWindow[fluentMica="true"] QMenuBar#menuBar,
QMainWindow#MainWindow[fluentMica="true"] QToolBar#toolBar,
QMainWindow#MainWindow[fluentMica="true"] QToolBar#toolBar > QWidget,
QMainWindow#MainWindow[fluentMica="true"] QStatusBar#statusBar,
QMainWindow#MainWindow[fluentMica="true"] QStatusBar#statusBar QLabel,
QMainWindow#MainWindow[fluentMica="true"] QDockWidget#logDock,
QMainWindow#MainWindow[fluentMica="true"] QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: transparent;
}

/* Game bar: the game, the pickers, last played and Run. */
QFrame#fluentHero {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QLabel#fluentHeroTitle {
    color: #EDEDED;
    font-size: 12pt;
    font-weight: 600;
    background-color: transparent;
}
QLabel#fluentHeroLabel {
    color: #BDBDBD;
    background-color: transparent;
}
QLabel#fluentHeroLogo {
    background-color: transparent;
}

/* Summary row below the header. */
QFrame#fluentStatTile {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
}
QFrame#fluentStatTile QLabel {
    background-color: transparent;
}
QLabel#fluentStatBadge {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 13pt;
    border-radius: 8px;
    color: #BDBDBD;
    background-color: #353535;
}
QLabel#fluentStatBadge[tone="accent"] {
    color: #E6E6E6;
    background-color: #333333;
}
QLabel#fluentStatBadge[tone="caution"] {
    color: #F5D58C;
    background-color: #3D3218;
}
QLabel#fluentStatBadge[tone="critical"] {
    color: #F0A0A0;
    background-color: #3A2627;
}
QLabel#fluentStatCaption {
    color: #8F8F8F;
}
QLabel#fluentStatValue {
    color: #EDEDED;
    font-size: 12pt;
    font-weight: 600;
}
QPushButton#fluentStatAction,
QPushButton#fluentFilterChip {
    min-height: 26px;
    max-height: 26px;
    padding: 0px 14px;
    color: #BDBDBD;
    background-color: #262626;
    border: 1px solid #353535;
    border-radius: 13px;
}
QPushButton#fluentStatAction:hover,
QPushButton#fluentFilterChip:hover {
    color: #EDEDED;
    background-color: #2B2B2B;
}
QPushButton#fluentFilterChip:checked {
    color: #E6E6E6;
    background-color: #333333;
    border-color: #6A6A6A;
}

/* Mods card title. */
QLabel#fluentCardTitle {
    color: #EDEDED;
    font-size: 12pt;
    font-weight: 600;
}

/* Settings-style navigation (FluentNavigation): the list paints its own
   rows; the pages lose the tab pane frame. */
QListWidget#fluentNav,
QListWidget#fluentNav:focus {
    background-color: transparent;
    border: none;
    outline: none;
}
QWidget#fluentNavPage {
    background-color: transparent;
}
QTabWidget[fluentNavigation="true"]::pane {
    border: none;
    background-color: transparent;
    top: 0px;
}

/* Settings rows (FluentSettings): title and description on the left, a
   toggle switch on the right, hairlines between the rows of a card. */
QFrame#fluentSettingRow {
    background-color: transparent;
    border: none;
    border-top: 1px solid #2C2C2C;
}
QFrame#fluentSettingRow:hover {
    background-color: #2A2A2A;
}
QLabel#fluentSettingTitle {
    color: #EDEDED;
    background-color: transparent;
}
QLabel#fluentSettingDescription {
    color: #8F8F8F;
    font-size: 8.5pt;
    background-color: transparent;
}
QLabel#fluentSettingTitle:disabled,
QLabel#fluentSettingDescription:disabled {
    color: #4F4F4F;
}
QCheckBox[fluentSwitch="true"] {
    spacing: 0px;
    background-color: transparent;
}
QCheckBox[fluentSwitch="true"]::indicator,
QCheckBox[fluentSwitch="true"]::indicator:unchecked {
    width: 40px;
    height: 20px;
    image: url(./mo2-fluent-v4-black/switch-off.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:unchecked:hover {
    image: url(./mo2-fluent-v4-black/switch-off-hover.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked {
    image: url(./mo2-fluent-v4-black/switch-on.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked:hover {
    image: url(./mo2-fluent-v4-black/switch-on-hover.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:unchecked:disabled {
    image: url(./mo2-fluent-v4-black/switch-off-disabled.svg);
}
QCheckBox[fluentSwitch="true"]::indicator:checked:disabled {
    image: url(./mo2-fluent-v4-black/switch-on-disabled.svg);
}
QFrame#fluentSettingRow[fluentGridRow="true"] {
    border-top: none;
}

/* Animated switches: FluentSwitchPainter draws them in these colors over the
   indicator, so the still images above are hidden. */
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked:hover,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked:hover,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:unchecked:disabled,
QCheckBox[fluentSwitch="true"][fluentAnimated="true"]::indicator:checked:disabled {
    image: none;
}
FluentSwitchPainter {
    qproperty-onColor: #D6D6D6;
    qproperty-offColor: #262626;
    qproperty-borderColor: #8F8F8F;
    qproperty-knobOnColor: #000000;
    qproperty-knobOffColor: #BDBDBD;
}

/* Settings controls at the Windows 11 size: 32px fields, buttons and lists
   (the page-specific rules of the base theme made them up to 44px). */
QDialog#SettingsDialog QWidget#fluentNavPage QPushButton {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 16px;
    border-radius: 4px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QLineEdit {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 10px;
    border-radius: 4px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QComboBox {
    min-height: 22px;
    max-height: 22px;
    padding: 4px 10px;
    border-radius: 4px;
}

/* Settings pages share the window surface with the navigation: no darker
   page panel behind the cards. */
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#generalTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#themeTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#uiTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#pathsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#nexusTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#pluginsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#workaroundTab,
QDialog#SettingsDialog QTabWidget#tabWidget QWidget#diagnosticsTab,
QDialog#SettingsDialog QTabWidget#tabWidget QStackedWidget#qt_tabwidget_stackedwidget,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea > QWidget#qt_scrollarea_viewport,
QDialog#SettingsDialog QTabWidget#tabWidget QScrollArea > QWidget#qt_scrollarea_viewport > QWidget,
QDialog#SettingsDialog QWidget#fluentPageContent {
    background-color: transparent;
    border: none;
}
QDialog#SettingsDialog QWidget#fluentNavPage QFrame#fluentSettingRow QLabel#fluentSettingTitle {
    font-weight: normal;
    padding: 0px;
}
QDialog#SettingsDialog QWidget#fluentNavPage QLabel#fluentSettingSubheading {
    color: #BDBDBD;
    font-weight: 600;
    padding: 10px 4px 2px 4px;
    background-color: transparent;
}

/* About MO2 Revamped (python plugin): pivot tabs like the rest of Fluent. */
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs::pane {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    top: -1px;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab {
    color: #BDBDBD;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    min-height: 22px;
    padding: 7px 12px 5px 12px;
    margin: 0px 2px 0px 0px;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab:hover {
    color: #EDEDED;
    background-color: transparent;
    border-bottom-color: #2C2C2C;
}
QDialog#MO2RevampedAboutDialog QTabWidget#mo2RevampedAboutTabs QTabBar::tab:selected {
    color: #EDEDED;
    background-color: transparent;
    border-bottom: 3px solid #D6D6D6;
}

/* About: the program logo stands on its own, without the round badge. */
QDialog#MO2RevampedAboutDialog QLabel#mo2RevampedAboutLogo {
    background-color: transparent;
    border: none;
    padding: 0px;
}
