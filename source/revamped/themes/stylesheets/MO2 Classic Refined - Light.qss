}
QDialog#filterOptionsDialog QComboBox#filtersSeparators:focus {
    border-color: #4B92C6;
}
QDialog#filterOptionsDialog QComboBox#filtersSeparators::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 27px;
    border: none;
    border-left: 1px solid #D7E2EA;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #EDF3F7;
}
QDialog#filterOptionsDialog QComboBox#filtersSeparators::down-arrow {
    image: url(./mo2-classic-refined-light/sort-down-light.svg);
    width: 10px;
    height: 8px;
}
QDialog#filterOptionsDialog QComboBox#filtersSeparators QAbstractItemView {
    color: #293847;
    background-color: #FFFFFF;
    selection-color: #183E5F;
    selection-background-color: #D7EAF9;
    border: 1px solid #CADAE4;
}
QDialog#filterOptionsDialog QDialogButtonBox#filterDialogButtons {
    background-color: transparent;
    border: none;
}
QDialog#filterOptionsDialog QDialogButtonBox#filterDialogButtons QPushButton {
