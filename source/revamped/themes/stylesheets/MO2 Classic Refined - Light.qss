/* Keep combo-box popups on one rounded surface; the inner viewport must not
   paint a rectangular background over the rounded frame. */
QComboBox QFrame {
    color: #293847;
    background-color: #FFFFFF;
    border: 1px solid #C7D3DD;
    border-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: transparent;
    border: none;
    border-radius: 7px;
    padding: 3px;
}

