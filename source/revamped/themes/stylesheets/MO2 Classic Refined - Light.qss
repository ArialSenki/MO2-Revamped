/* Log dock and status strip: keep diagnostic rows readable without a hard selection band. */
QDockWidget#logDock {
    color: #293847;
    background-color: #F4F7FA;
    border: 1px solid #CFDCE6;
    border-radius: 8px;
}
QWidget#logDockTitleBar {
    min-height: 34px;
    max-height: 34px;
    background-color: #F4F7FA;
    border: none;
    border-bottom: 1px solid #DCE5EC;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QLabel#logDockTitleLabel {
    color: #38566E;
    font-weight: 600;
    background-color: transparent;
    border: none;
    padding: 0;
}
QToolButton#logDockCloseButton,
QToolButton#logDockFloatButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #466F88;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 0;
    padding: 0;
}
QToolButton#logDockCloseButton:hover,
QToolButton#logDockFloatButton:hover {
    background-color: transparent;
    border-color: transparent;
}
QToolButton#logDockCloseButton:pressed,
QToolButton#logDockFloatButton:pressed {
    background-color: transparent;
    border-color: transparent;
}
QDockWidget#logDock QWidget#dockWidgetContents {
    background-color: #F4F7FA;
    border: none;
}
QDockWidget#logDock QTreeView#logList {
    color: #293847;
    background-color: #FFFFFF;
    alternate-background-color: #F6F9FC;
    selection-color: #183E5F;
    selection-background-color: #D7EAF9;
    border: 1px solid #CFDCE6;
    border-radius: 7px;
    outline: none;
    padding: 2px;
}
QDockWidget#logDock QTreeView#logList::item,
QDockWidget#logDock QTreeView#logList::item:hover,
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:focus,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    min-height: 19px;
    padding: 3px 8px;
    margin: 0;
    border: none;
}
QDockWidget#logDock QTreeView#logList::item:hover:!selected {
    background-color: #EDF4F9;
}
QDockWidget#logDock QTreeView#logList::item:selected,
QDockWidget#logDock QTreeView#logList::item:selected:focus,
QDockWidget#logDock QTreeView#logList::item:hover:selected {
    color: #183E5F;
    background-color: #D7EAF9;
}
QStatusBar {
    color: #526E84;
    background-color: #EDF3F7;
    border-top: 1px solid #D1DEE7;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel#apistats {
    margin: 2px 4px;
    padding: 2px 8px;
    border-radius: 5px;
    font-weight: 600;
}
QStatusBar QLabel#apistats[apiState="offline"] {
    color: #687B89;
    background-color: transparent;
    border: none;
}
QStatusBar QLabel#apistats[apiState="healthy"] {
    color: #315F40;
    background-color: #E5F1E8;
    border: 1px solid #BFD7C5;
}
QStatusBar QLabel#apistats[apiState="warning"] {
    color: #755C1F;
    background-color: #FAF0D1;
    border: 1px solid #E6D8A4;
}
QStatusBar QLabel#apistats[apiState="low"] {
    color: #843F37;
    background-color: #F8E7E4;
    border: 1px solid #E7C5C0;
}

