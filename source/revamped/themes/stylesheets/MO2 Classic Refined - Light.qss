QDialog#EditExecutablesDialog QDialogButtonBox#buttons QPushButton {
    min-width: 76px;
    min-height: 31px;
    padding: 4px 12px;
    border-radius: 5px;
}

/* Executable editor: grouped layout and clearer hierarchy */
QDialog#EditExecutablesDialog QFrame#headerCard {
    color: #293847;
    background-color: #E9F1F6;
    border: 1px solid #D5DEE7;
    border-radius: 8px;
}
QDialog#EditExecutablesDialog QLabel#dialogHeading,
QDialog#EditExecutablesDialog QLabel#detailsHeading {
    color: #1D3F5B;
    font-size: 12pt;
    font-weight: 600;
}
QDialog#EditExecutablesDialog QLabel#detailsHeading {
    font-size: 11pt;
}
QDialog#EditExecutablesDialog QLabel#dialogDescription,
QDialog#EditExecutablesDialog QLabel#detailsHint,
QDialog#EditExecutablesDialog QLabel#executableHint {
    color: #657B8D;
    font-size: 9pt;
}
QDialog#EditExecutablesDialog QGroupBox#launchGroup,
QDialog#EditExecutablesDialog QGroupBox#optionsGroup {
    color: #30495D;
    background-color: #FFFFFF;
    border: 1px solid #D5DEE7;
    border-radius: 7px;
    margin-top: 10px;
    padding-top: 8px;
}
QDialog#EditExecutablesDialog QGroupBox#launchGroup::title,
QDialog#EditExecutablesDialog QGroupBox#optionsGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 11px;
    padding: 0 5px;
    color: #1D3F5B;
    background-color: #FFFFFF;
    font-weight: 600;
}
QDialog#EditExecutablesDialog QScrollArea#detailScroll,
QDialog#EditExecutablesDialog QWidget#detailContent {
    background-color: transparent;
    border: none;
}
QDialog#EditExecutablesDialog QLabel#steamAppIdLabel {
    color: #405A6B;
    font-weight: 600;
}
QDialog#EditExecutablesDialog QToolButton#add,
QDialog#EditExecutablesDialog QToolButton#remove,
QDialog#EditExecutablesDialog QToolButton#up,
QDialog#EditExecutablesDialog QToolButton#down,
QDialog#EditExecutablesDialog QToolButton#reset {
    min-width: 0px;
    min-height: 30px;
    padding: 4px 7px;
}

/* MO2 Revamped: framed gear-action dialogs */
QDialog#modListNameDialog QFrame#gearActionCard,
QDialog#bulkModToggleDialog QFrame#gearActionCard,
QDialog#assignCategoriesDialog QFrame#gearActionCard {
    color: #293847;
    background-color: #F7FAFC;
    border: 1px solid #D5DEE7;
    border-radius: 7px;
}
QDialog#modListNameDialog QFrame#gearActionCard QLabel,
QDialog#bulkModToggleDialog QFrame#gearActionCard QLabel,
QDialog#assignCategoriesDialog QFrame#gearActionCard QLabel,
QDialog#assignCategoriesDialog QFrame#gearActionCard QCheckBox {
    background-color: transparent;
}
QDialog#modListNameDialog QFrame#gearActionDivider,
QDialog#bulkModToggleDialog QFrame#gearActionDivider,
QDialog#assignCategoriesDialog QFrame#gearActionDivider,
QDialog#ExportModListDialog QFrame#gearActionDivider {
    background-color: #D5DEE7;
    border: none;
    max-height: 1px;
}

/* MO2 Revamped: profile backup cards and separators */
QDialog#profileBackupPromptDialog QLabel#profileBackupPromptTitle,
QDialog#profileBackupDialog QLabel#backupContentsHeading {
    color: #1D3F5B;
}
QDialog#profileBackupPromptDialog QLabel#profileBackupPromptDescription,
QDialog#profileBackupDialog QLabel#backupModListDetails,
QDialog#profileBackupDialog QLabel#backupPluginOrderDetails {
    color: #566B7C;
    background-color: transparent;
}
QDialog#profileBackupPromptDialog QFrame#profileBackupPromptCard,
QDialog#profileBackupDialog QFrame#backupModListCard,
QDialog#profileBackupDialog QFrame#backupPluginOrderCard {
    color: #293847;
    background-color: #F7FAFC;
    border: 1px solid #D5DEE7;
    border-radius: 7px;
}
QDialog#profileBackupPromptDialog QFrame#profileBackupPromptDivider {
    color: #D5DEE7;
    background-color: #D5DEE7;
    border: none;
    max-height: 1px;
}
QDialog#profileBackupDialog QLabel#backupContentsHeading {
    font-weight: 600;
}
QDialog#profileBackupDialog QFrame#backupModListCard QCheckBox,
QDialog#profileBackupDialog QFrame#backupPluginOrderCard QCheckBox {
    background-color: transparent;
}

/* Mod Info empty states */
QDialog#ModInfoDialog QFrame#modInfoEmptyStateCard {
    background-color: #F7FAFC;
    border: 1px solid #D5DEE7;
    border-radius: 8px;
}
QDialog#ModInfoDialog QLabel#modInfoEmptyStateTitle {
    color: #29435B;
    font-size: 12pt;
    font-weight: 600;
    background-color: transparent;
}
QDialog#ModInfoDialog QLabel#modInfoEmptyStateDescription,
QDialog#ModInfoDialog QLabel#modInfoEmptyListState {
    color: #6F8190;
    background-color: transparent;
    padding: 6px;
}
