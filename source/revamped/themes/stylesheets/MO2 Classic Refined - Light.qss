QDialog#SettingsDialog QWidget#generalTab QLabel#generalActionsIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeStyleIcon,
QDialog#SettingsDialog QWidget#themeTab QLabel#themeColorsIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListDisplayIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#modListWorkflowIcon,
QDialog#SettingsDialog QWidget#uiTab QLabel#collapsibleSeparatorsSectionIcon {
    background-color: #EAF2F8;
    border: 1px solid #C8DCE9;
    border-radius: 13px;
