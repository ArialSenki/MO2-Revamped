              <item>
               <widget class="QLabel" name="workaroundsBehaviorDescription">
                <property name="text">
                 <string>Adjust how MO2 treats core game files, archives, and the interface while an executable runs.</string>
                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="forceEnableBox">
                <property name="toolTip">
                 <string>Prevent core game files such as plugins and archives from being disabled in the UI. Disable this only for total conversions; required game files may otherwise be missing.</string>
                </property>
                <property name="whatsThis">
                 <string>Prevent core game files from being disabled in the UI. For a total conversion, you may need to disable this option, but the game can fail to start if required files are not enabled.</string>
                </property>
                <property name="text">
                 <string>Keep core game files enabled</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="enableArchiveParsingBox">
                <property name="toolTip">
                 <string>Inspect archive contents to calculate file conflicts. This experimental scan can slow down conflict checks and may report incorrect results; it does not load archives into the game.</string>
                </property>
                <property name="whatsThis">
                 <string>Archive parsing compares files inside supported archives with other files to display conflicts. It has a performance cost and does not extract or load archives into the game.</string>
                </property>
                <property name="text">
                 <string>Check archive contents for conflicts (experimental)</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="lockGUIBox">
                <property name="toolTip">
                 <string>Keep MO2's interface locked while a launched executable is running. Disabling the lock can cause abnormal behavior.</string>
                </property>
                <property name="whatsThis">
                 <string>Keep the MO2 interface unavailable while a launched executable runs. Disabling the lock can cause abnormal behavior.</string>
                </property>
                <property name="text">
                 <string>Keep MO2 locked while a program runs</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
